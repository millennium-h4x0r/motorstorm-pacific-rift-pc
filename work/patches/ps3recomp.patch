+    u64 l[16];
+    _mm256_storeu_si256((__m256i*)&l[0], a0); _mm256_storeu_si256((__m256i*)&l[4], a1);
+    _mm256_storeu_si256((__m256i*)&l[8], a2); _mm256_storeu_si256((__m256i*)&l[12], a3);
