+#!/usr/bin/env python3
+"""--local-regs and --const-bi must not change what a lifted program computes.
+
+--local-regs keeps a function's registers in C locals and syncs them with
+ctx->gpr only around statements that hand ctx to the runtime and before every
+exit; --const-bi turns `bi $rN` after `il/ila $rN` into a goto or a direct
+trampoline. Each fixture is lifted with and without the options, compiled, run
+and compared:
+
+  * the --merge-chunks interrupt loop: the counter lives in a local while the
+    drain's handler writes r5 in ctx, so the result needs the write-back at the
+    chunk-entry exit and the reload when the function is entered again;
+  * a constant `bi` that becomes a goto, with a local-store round trip;
+  * an opaque runtime call (wrch to the outbound mailbox) that must see the
+    registers written just before it and whose register writes must be seen
+    after it.
+
+Usage:
+    python3 tools/test_spu_lifter_local_regs.py
+"""
+
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+RUNTIME = TOOLS.parent / 'runtime' / 'spu'
+sys.path.insert(0, str(TOOLS))
+
+from spu_disasm import disassemble_spu  # noqa: E402
+from spu_lifter import (SPULifter, merge_chunk_groups,  # noqa: E402
+                        compute_const_bi_targets, localize_registers)
+
+
+def ri16(op9, i16, rt):
+    return (op9 << 23) | ((i16 & 0xFFFF) << 7) | rt
+
+
+def ri18(op7, i18, rt):
+    return (op7 << 25) | ((i18 & 0x3FFFF) << 7) | rt
+
+
+def ri10(op8, i10, ra, rt):
+    return (op8 << 24) | ((i10 & 0x3FF) << 14) | (ra << 7) | rt
+
+
+def rr(op11, rb, ra, rt):
+    return (op11 << 21) | (rb << 14) | (ra << 7) | rt
+
+
+IL, ILA, AI, CEQI, OR, BRZ, BI = 0x081, 0x21, 0x1C, 0x7C, 0x041, 0x040, 0x1A8
+STQD, LQD, WRCH, A = 0x24, 0x34, 0x10D, 0x0C0
+
+# 1. The --merge-chunks interrupt loop: count r3 up until the handler sets r5.
+LOOP = ([ri16(IL, 0, 3),                      # 0x00 il   $3, 0
+         ri10(AI, 1, 3, 3),                   # 0x04 ai   $3, $3, 1   <- loop
+         ri10(CEQI, 100, 3, 6),               # 0x08 ceqi $6, $3, 100
+         rr(OR, 6, 5, 7),                     # 0x0C or   $7, $5, $6
+         ri16(BRZ, (0x04 - 0x10) >> 2, 7),    # 0x10 brz  $7, 0x04
+         rr(BI, 0, 0, 0)],                    # 0x14 bi   $0
+        [(0x00, 0x04), (0x04, 0x18)])
+
+# 2. A constant `bi` forward inside the function, around an LS round trip.
+CONSTBI = ([ri16(IL, 5, 3),                   # 0x00 il   $3, 5
+            ri16(IL, 0, 9),                   # 0x04 il   $9, 0
+            ri10(STQD, 0x100 >> 4, 9, 3),     # 0x08 stqd $3, 0x100($9)
+            ri18(ILA, 0x18, 4),               # 0x0C ila  $4, 0x18
+            rr(BI, 0, 4, 0),                  # 0x10 bi   $4  -> 0x18
+            ri16(IL, 99, 5),                  # 0x14 il   $5, 99  (skipped)
+            ri10(LQD, 0x100 >> 4, 9, 5),      # 0x18 lqd  $5, 0x100($9)
+            ri10(AI, 1, 5, 5),                # 0x1C ai   $5, $5, 1
+            rr(BI, 0, 0, 0)],                 # 0x20 bi   $0
+           [(0x00, 0x24)])
+
+# 3. wrch $ch28 (SPU_WrOutMbox) between register work done in locals.
+SYNC = ([ri16(IL, 11, 6),                     # 0x00 il   $6, 11
+         ri10(AI, 2, 6, 6),                   # 0x04 ai   $6, $6, 2   (13)
+         rr(WRCH, 0, 28, 6),                  # 0x08 wrch $ch28, $6
+         ri10(AI, 1, 7, 8),                   # 0x0C ai   $8, $7, 1   (r7 set by the call)
+         rr(A, 6, 8, 8),                      # 0x10 a    $8, $8, $6
+         rr(BI, 0, 0, 0)],                    # 0x14 bi   $0
+        [(0x00, 0x18)])
+
+DRIVER = r'''
+#include "lifted.h"
+#include <stdio.h>
+#include <string.h>
+SPU_THREAD_LOCAL void (*g_spu_trampoline_fn)(spu_context*);
+volatile int g_spu_direct = 0;              /* SPU_DIRECT off: every hop drains */
+uint8_t g_spu_stack_reset_hint[1024];
+int g_spu_ls_watch_n = 0;
+static int returned, indirect;
+static uint32_t seen6 = 0xFFFFFFFF;
+void spu_indirect_branch(spu_context* ctx) { (void)ctx; indirect++; returned = 1; }
+void spu_register_function(uint32_t addr, void (*fn)(spu_context*)) { (void)addr; (void)fn; }
+void spu_ls_watch_slow(uint32_t lsa, int w, const uint8_t* p, uint32_t pc, uint32_t lr)
+{ (void)lsa; (void)w; (void)p; (void)pc; (void)lr; }
+void spu_wrch(spu_context* ctx, uint32_t ch, u128 v)
+{
+    (void)ch; (void)v;
+    seen6 = ctx->gpr[6]._u32[0];            /* written back before the call? */
+    ctx->gpr[7]._u32[0] = 42;               /* reloaded after it? */
+}
+int main(void) {
+    static spu_context c;
+    static uint8_t ls[SPU_LS_SIZE];
+    uint32_t taken_at = 0;
+    c.ls = ls;
+    c.int_enable = FIXTURE_IRQ; c.event_mask = 1; c.event_status = 1;
+    spu_func_00000000(&c);
+    /* The drain: deliver a pending interrupt before each transfer. The
+     * "handler" acknowledges the event and sets r5, ending the wait loop. */
+    while (g_spu_trampoline_fn && !returned) {
+        void (*fn)(spu_context*) = g_spu_trampoline_fn;
+        g_spu_trampoline_fn = 0;
+        if (c.int_enable && (c.event_status & c.event_mask)) {
+            taken_at = c.pc; c.event_status = 0; c.gpr[5]._u32[0] = 1;
+        }
+        fn(&c);
+    }
+    printf("%x %u %u %u %u %d\n", taken_at, c.gpr[3]._u32[0], c.gpr[5]._u32[0],
+           c.gpr[8]._u32[0], seen6, indirect);
+    return 0;
+}
+'''
+
+
+def lift(fixture, merge=False, local_regs=False, const_bi=False):
+    words, bounds = fixture
+    insns = disassemble_spu(b''.join(struct.pack('>I', w) for w in words), 0)
+    lifter = SPULifter()
+    lifter.func_starts = {s for s, _ in bounds}
+    lifter.local_regs = local_regs
+    if const_bi:
+        lifter.const_bi = compute_const_bi_targets(insns, bounds)
+    groups = merge_chunk_groups(insns, bounds, 4096, entry_points={0}) if merge else {}
+    for s, e in bounds:
+        lifter.lift_function(insns, s, groups.get(s, e))
+    return lifter
+
+
+class LocalRegs(unittest.TestCase):
+
+    def run_program(self, lifter, irq):
+        cc = shutil.which('clang') or shutil.which('cc')
+        if not cc:
+            if os.environ.get('CI'):
+                self.fail('C compiler required in CI')
+            self.skipTest('C compiler unavailable')
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            context = (RUNTIME / 'spu_context.h').as_posix()
+            helpers = (RUNTIME / 'spu_helpers.h').as_posix()
+            (root / 'lifted.h').write_text(lifter.emit_header().replace(
+                '../../runtime/spu/spu_context.h', context))
+            src = lifter.emit_source('lifted.h').replace('../../runtime/spu/spu_helpers.h', helpers)
+            (root / 'lifted.c').write_text(src)
+            (root / 'driver.c').write_text(DRIVER)
+            exe = root / ('proof.exe' if sys.platform == 'win32' else 'proof')
+            built = subprocess.run([cc, '-O2', '-std=gnu11', f'-DFIXTURE_IRQ={irq}',
+                                    '-I', str(RUNTIME), '-o', str(exe),
+                                    str(root / 'lifted.c'), str(root / 'driver.c')],
+                                   capture_output=True, text=True)
+            self.assertEqual(built.returncode, 0, built.stderr + src)
+            ran = subprocess.run([str(exe)], capture_output=True, text=True, timeout=30)
+            self.assertEqual(ran.returncode, 0, ran.stderr)
+            return ran.stdout.split(), src
+
+    def test_interrupt_loop_same_with_local_regs(self):
+        base, _ = self.run_program(lift(LOOP, merge=True), 1)
+        lr, src = self.run_program(lift(LOOP, merge=True, local_regs=True), 1)
+        self.assertEqual(base[:2], ['4', '1'])
+        self.assertEqual(lr, base)
+        self.assertIn('spu_v4u sr3', src)
