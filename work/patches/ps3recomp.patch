+/* ---- GPU-side vertex fetch (PS3RECOMP_ENG_GPUFETCH=1) --------------------
+ *
+ * The CPU path turns every draw's indices into a reference list, decodes the
+ * referenced vertices into float4 attributes and uploads them; even with the
+ * decoded-vertex cache hitting, building the references, hashing them for the
+ * key and copying the cached vertices out costs the FIFO thread several ms a
+ * pack-racing frame. Here the draw's RAW guest bytes go to the GPU instead,
+ * and its vertex shader does the fetch: it reads the index (or counts the
+ * array), applies the base index and the frequency divider, and decodes each
+ * attribute from big-endian guest data (eng_vs_to_fetch's preamble).
+ *
+ * The bytes live in a pool the backend maps for us (fetch_pool), as
+ * content-addressed, immutable blocks: a block is a guest range keyed by the
+ * hash of its bytes (eng_range_hash, so the same per-frame memo and SPU-write
+ * generations as the vertex cache) and is reused by every later draw whose
+ * range hashes the same. A fixed-address mirror updated per dirty page was
+ * the other option, but its pages could not be rewritten while earlier draws
+ * of the same frame still read the old bytes (copies cannot go inside a
+ * render pass, and dynamic vertex rings are rewritten within a frame), which
+ * immutable blocks never need. The pool is a ring in allocation order: the
+ * head overwrites the oldest blocks once the GPU has finished every draw that
+ * read them (fetch_serial), and a block still in use when the head comes
+ * near is copied forward again, so the ring keeps the working set and only
+ * a pool too small for one frame's ranges stalls -- then the draw falls back
+ * to the CPU path instead of waiting.
+ *
+ * Draws with a single run of indices or vertices (or contiguous runs) and no
+ * restart cut inside it, through the guest's own programs, go this way;
+ * everything else (inline and immediate vertices, restart cuts, attribute
+ * ranges that do not resolve) takes the CPU path unchanged. */
+#define ENG_GF_TABLE   (1u << 18)              /* block hash table slots      */
+#define ENG_GF_BLOCKS  (1u << 17)              /* block records, a ring       */
+#define ENG_GF_DEAD    0xFFFFFFFFu             /* table tombstone             */
+typedef struct {
+    u64 h1, h2;
+    u64 serial;          /* last use: fetch_serial at the draw               */
+    u32 off, len;        /* in the pool                                       */
+    u32 kind;            /* 0 vertex bytes; indices: 1 u16, 2 u32 as in guest
+                          * memory, 3 u16, 4 u32 byteswapped (a host index
+                          * buffer); 5 a disabled attribute's constant        */
+    u32 vmin, vmax;      /* index blocks: range of the indices, all-ones out  */
+    u8  live, ones;      /* ones: the all-ones index (restart value) occurs   */
+} eng_gf_block;
+typedef struct { u32 d[4]; u32 a[32]; float xf[8]; } eng_gf_push;   /* 176 B of VS push constants */
+
+static struct {
+    int state;           /* 0 not decided yet, 1 on, 2 off                     */
+    u8* pool;
+    u32 size, head;
+    eng_gf_block* blk;   /* ENG_GF_BLOCKS ring, allocation order              */
+    u32 btail, bhead, bcount;
+    u32* table;          /* block index + 1, 0 empty, ENG_GF_DEAD tombstone   */
+    u32 used, dead;      /* table occupancy                                   */
+    u64 serial, done;    /* this draw's serial, completed serial              */
+    u64 draws, falls, bytes_in, migrations, stalls;
+} s_gf;
+
+static int eng_gf_on(void)
+{
+    if (s_gf.state) return s_gf.state == 1;
+    s_gf.state = 2;
+    const char* e = getenv("PS3RECOMP_ENG_GPUFETCH");
+    if (!(e && *e && *e != '0')) return 0;
+    if (!g.be->fetch_pool || !g.be->fetch_serial || !g.be->draw_fetch) {
+        fprintf(stderr, "[rsx engine] gpufetch: backend has no pull draws, CPU fetch\n");
+        return 0;
+    }
+    s_gf.pool = (u8*)g.be->fetch_pool(g.be->user, &s_gf.size);
+    s_gf.size = s_gf.size > 16u ? (s_gf.size - 16u) & ~15u : 0;   /* the shader reads a word past a block */
+    s_gf.blk = (eng_gf_block*)calloc(ENG_GF_BLOCKS, sizeof *s_gf.blk);
+    s_gf.table = (u32*)calloc(ENG_GF_TABLE, sizeof *s_gf.table);
+    if (!s_gf.pool || s_gf.size < (16u << 20) || !s_gf.blk || !s_gf.table) {
+        fprintf(stderr, "[rsx engine] gpufetch: no pool (%u bytes), CPU fetch\n", s_gf.size);
+        free(s_gf.blk); free(s_gf.table); s_gf.blk = NULL; s_gf.table = NULL;
+        return 0;
+    }
+    fprintf(stderr, "[rsx engine] gpufetch: on, %u MB pool\n", s_gf.size >> 20);
+    s_gf.state = 1;
+    return 1;
+}
+
+static u32 eng_gf_slot(u64 h1) { return (u32)(h1 >> 20) & (ENG_GF_TABLE - 1u); }
+
+/* Rebuild the table without tombstones. */
+static void eng_gf_rehash(void)
+{
+    memset(s_gf.table, 0, ENG_GF_TABLE * sizeof *s_gf.table);
+    s_gf.used = s_gf.dead = 0;
+    for (u32 n = 0, i = s_gf.btail; n < s_gf.bcount; n++, i = (i + 1u) & (ENG_GF_BLOCKS - 1u)) {
+        if (!s_gf.blk[i].live) continue;
+        u32 s = eng_gf_slot(s_gf.blk[i].h1);
+        while (s_gf.table[s]) s = (s + 1u) & (ENG_GF_TABLE - 1u);
+        s_gf.table[s] = i + 1u;
+        s_gf.used++;
+    }
+}
+
+static u32* eng_gf_find_slot(u64 h1, u64 h2, u32 len, u32 kind)
+{
+    for (u32 s = eng_gf_slot(h1);; s = (s + 1u) & (ENG_GF_TABLE - 1u)) {
+        const u32 v = s_gf.table[s];
+        if (!v) return NULL;
+        if (v == ENG_GF_DEAD) continue;
+        const eng_gf_block* b = &s_gf.blk[v - 1u];
+        if (b->h1 == h1 && b->h2 == h2 && b->len == len && b->kind == kind) return &s_gf.table[s];
+    }
+}
+
+static void eng_gf_unlink(u32 index)
+{
+    eng_gf_block* b = &s_gf.blk[index];
+    if (!b->live) return;
+    b->live = 0;
+    u32* t = eng_gf_find_slot(b->h1, b->h2, b->len, b->kind);
+    if (t && *t == index + 1u) { *t = ENG_GF_DEAD; s_gf.dead++; }
+}
+
+/* Drop the oldest record; 0 when the GPU may still read its bytes. */
+static int eng_gf_retire_tail(void)
+{
+    eng_gf_block* b = &s_gf.blk[s_gf.btail];
+    if (b->serial > s_gf.done) {
+        unsigned long long done = 0;
+        g.be->fetch_serial(g.be->user, &done);
+        s_gf.done = done;
+        if (b->serial > s_gf.done) return 0;
+    }
+    eng_gf_unlink(s_gf.btail);
+    s_gf.btail = (s_gf.btail + 1u) & (ENG_GF_BLOCKS - 1u);
+    s_gf.bcount--;
+    return 1;
+}
+
+/* Room for `len` bytes at the head, or ~0u. */
+static u32 eng_gf_alloc(u32 len)
+{
+    len = (len + 15u) & ~15u;
+    if (len > s_gf.size / 8u) return ~0u;
+    if (s_gf.bcount == ENG_GF_BLOCKS && !eng_gf_retire_tail()) return ~0u;
+    u32 h = s_gf.head;
+    if (h + len > s_gf.size) {
+        /* The rest of the ring is skipped: retire what lies there first. */
+        while (s_gf.bcount && s_gf.blk[s_gf.btail].off >= h)
+            if (!eng_gf_retire_tail()) return ~0u;
+        h = 0;
+    }
+    while (s_gf.bcount) {
+        const eng_gf_block* t = &s_gf.blk[s_gf.btail];
+        if (!(t->off < h + len && t->off + t->len > h)) break;
+        if (!eng_gf_retire_tail()) { s_gf.stalls++; return ~0u; }
+    }
+    s_gf.head = h + len;
+    return h;
+}
+
+static void eng_gf_link(u32 i)
+{
+    if (s_gf.used + 1u > ENG_GF_TABLE / 2u || s_gf.dead > ENG_GF_TABLE / 8u) eng_gf_rehash();
+    u32 s = eng_gf_slot(s_gf.blk[i].h1);
+    while (s_gf.table[s] && s_gf.table[s] != ENG_GF_DEAD) s = (s + 1u) & (ENG_GF_TABLE - 1u);
+    if (s_gf.table[s] == ENG_GF_DEAD) s_gf.dead--; else s_gf.used++;
+    s_gf.table[s] = i + 1u;
+}
+
+/* A new record at the head of the block ring for `n` bytes copied from p
+ * (byteswapped for kinds 3 and 4). */
+static eng_gf_block* eng_gf_push_block(const eng_gf_block* proto, const u8* p, u32 n)
+{
+    const u32 off = eng_gf_alloc(n);
+    if (off == ~0u) return NULL;
+    u8* dst = s_gf.pool + off;
+    if (proto->kind == 3u) {
+        for (u32 k = 0; k + 2u <= n; k += 2u) { u16 v; memcpy(&v, p + k, 2); v = __builtin_bswap16(v); memcpy(dst + k, &v, 2); }
+    } else if (proto->kind == 4u) {
+        for (u32 k = 0; k + 4u <= n; k += 4u) { u32 v; memcpy(&v, p + k, 4); v = __builtin_bswap32(v); memcpy(dst + k, &v, 4); }
+    } else {
+        memcpy(dst, p, n);
+    }
+    const u32 i = s_gf.bhead;
+    eng_gf_block* b = &s_gf.blk[i];
+    *b = *proto;
+    b->off = off; b->len = n; b->serial = s_gf.serial; b->live = 1;
+    s_gf.bhead = (i + 1u) & (ENG_GF_BLOCKS - 1u);
+    s_gf.bcount++;
+    eng_gf_link(i);
+    return b;
+}
+
+/* The pool block holding [p, p + n) of guest memory, copied in on a miss and
+ * copied forward when the head is about to overwrite it. NULL when the pool
+ * has no room for it now. */
+static eng_gf_block* eng_gf_block_get_h(eng_vhash h, const u8* p, u32 n, u32 kind);
+static eng_gf_block* eng_gf_block_get(const u8* p, u32 n, u32 location, u32 offset, u32 kind)
+{
+    return eng_gf_block_get_h(eng_range_hash(p, n, location, offset), p, n, kind);
+}
+static eng_gf_block* eng_gf_block_get_h(eng_vhash h, const u8* p, u32 n, u32 kind)
+{
+    u32* t = eng_gf_find_slot(h.h1, h.h2, n, kind);
+    if (t) {
+        eng_gf_block* b = &s_gf.blk[*t - 1u];
+        const u32 ahead = b->off >= s_gf.head ? b->off - s_gf.head : b->off + s_gf.size - s_gf.head;
+        if (ahead >= s_gf.size / 4u) { b->serial = s_gf.serial; return b; }
+        const eng_gf_block keep = *b;
+        eng_gf_unlink(*t - 1u);
+        s_gf.migrations++;
+        return eng_gf_push_block(&keep, p, n);
+    }
+    eng_gf_block proto;
+    memset(&proto, 0, sizeof proto);
+    proto.h1 = h.h1; proto.h2 = h.h2; proto.kind = kind;
+    if (kind >= 1u && kind <= 4u) {   /* an index block */
+        /* The range of the indices without the all-ones value, and whether
+         * that occurs: it is the only restart value the pull path takes. */
+        u32 lo = 0xFFFFFFFFu, hi = 0;
+        int ones = 0;
+        if (kind == 2u || kind == 4u) {
+            for (u32 k = 0; k + 4u <= n; k += 4u) {
+                const u32 v = ((u32)p[k] << 24) | ((u32)p[k + 1] << 16) | ((u32)p[k + 2] << 8) | p[k + 3];
+                if (v == 0xFFFFFFFFu) { ones = 1; continue; }
+                if (v < lo) lo = v;
+                if (v > hi) hi = v;
+            }
+        } else {
+            for (u32 k = 0; k + 2u <= n; k += 2u) {
+                const u32 v = ((u32)p[k] << 8) | p[k + 1];
+                if (v == 0xFFFFu) { ones = 1; continue; }
+                if (v < lo) lo = v;
+                if (v > hi) hi = v;
+            }
+        }
+        proto.vmin = lo; proto.vmax = hi; proto.ones = (u8)ones;
+    }
+    s_gf.bytes_in += n;
+    return eng_gf_push_block(&proto, p, n);
+}
+
+/* Map a draw onto the pull path: fill the VS push block and copy every range
+ * it reads into the pool. 0 = take the CPU path. */
