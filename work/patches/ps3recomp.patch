+/* The key of the draw dc holds now: refs are the raw list (before the
+ * remap). Returns 0 when the draw cannot be cached. */
+static int eng_vcache_key(const rsx_vertex_layout_plan* layout, eng_vhash* out)
+{
+    const rsx_vertex_fetch_plan* plan = &dc.fetch_plan;
+    if (plan->inline_data || dc.n_immediate || !dc.n_refs) return 0;
+    eng_vhash h = { 0xcbf29ce484222325ull, 0x84222325cbf29ce4ull };
+    eng_vhash_words(&h, &layout->mask, sizeof layout->mask);
+    eng_vhash_words(&h, &layout->stride, sizeof layout->stride);
+    eng_vhash_words(&h, &plan->base_offset, sizeof plan->base_offset);
+    eng_vhash_words(&h, &plan->divider_mask, sizeof plan->divider_mask);
+    eng_vhash_words(&h, &g.rsx.current_primitive, sizeof g.rsx.current_primitive);
+    eng_vhash_words(&h, dc.cuts, (size_t)dc.n_cuts * sizeof(*dc.cuts));
+    for (u32 slot = 0; slot < layout->count; slot++) {
+        const rsx_vertex_fetch_attr* f = &plan->attr[layout->attrs[slot]];
+        eng_vhash_words(&h, &f->desc, sizeof f->desc);
+        eng_vhash_words(&h, f->default_value, sizeof f->default_value);
+        if (!f->desc.type || !f->desc.size) continue;       /* default only */
+        if (!f->stable_base) return 0;
+        const u32 span = f->stable_last - f->stable_first;
+        const u64 bytes = (u64)span * f->stride + f->elem_size;
+        if (bytes > (64u << 20)) return 0;
+        eng_vhash_words(&h, &f->stable_first, sizeof f->stable_first);
+        eng_vhash_words(&h, &span, sizeof span);
+        const u32 src_off = rsx_dsp_resolve_vertex_offset(plan->base_offset, f->desc.offset) +
+                            f->stable_first * f->stride;
+        const eng_vhash rh = eng_range_hash(f->stable_base, bytes, f->desc.location, src_off);
+        eng_vhash_words(&h, &rh, sizeof rh);
+    }
+    eng_vhash_words(&h, dc.refs, (size_t)dc.n_refs * sizeof(*dc.refs));
+    eng_vhash_words(&h, &dc.n_cuts, sizeof dc.n_cuts);
+    *out = h;
+    return 1;
+}
