diff --git a/libs/misc/cellAvconfExt.h b/libs/misc/cellAvconfExt.h
index 9ab90ee1..d3c697c4 100644
--- a/libs/misc/cellAvconfExt.h
+++ b/libs/misc/cellAvconfExt.h
@@ -44,11 +44,16 @@ extern "C" {
  * Types
  * -----------------------------------------------------------------------*/
 
+/* Guest layouts (big-endian). CellAudioOutSoundMode is 8 bytes: the SDK's
+ * struct ends in a u32 speaker layout. CellAudioOutDeviceInfo has a u16
+ * latency before the modes, so they start at offset 8. Multi-byte fields
+ * are stored byte-swapped (see cellAvconfExt.c). */
 typedef struct CellAudioOutSoundMode {
     u8  type;
     u8  channel;
     u8  fs;
     u8  reserved;
+    u32 layout;          /* big-endian CELL_AUDIO_OUT_SPEAKER_LAYOUT_* */
 } CellAudioOutSoundMode;
 
 typedef struct CellAudioOutDeviceInfo {
@@ -56,9 +61,16 @@ typedef struct CellAudioOutDeviceInfo {
     u8  availableModeCount;
     u8  state;
     u8  reserved[3];
+    u16 latency;         /* big-endian */
     CellAudioOutSoundMode availableModes[16];
 } CellAudioOutDeviceInfo;
 
+#define CELL_AUDIO_OUT_DEVICE_STATE_UNAVAILABLE  0
+#define CELL_AUDIO_OUT_DEVICE_STATE_AVAILABLE    1
+#define CELL_AUDIO_OUT_SPEAKER_LAYOUT_2CH            0x00000001u
+#define CELL_AUDIO_OUT_SPEAKER_LAYOUT_6CH_LREClr     0x00010000u
+#define CELL_AUDIO_OUT_SPEAKER_LAYOUT_8CH_LREClrxy   0x40000000u
+
 typedef struct CellAudioOutConfiguration {
     u8  channel;
     u8  encoder;
