+/* A texture that names only the top-left corner of a colour target, at the
+ * target's own pitch. On RSX the texture IS that memory, so its normalised
+ * coordinates run over its own width and height -- the corner -- while a view
+ * of the whole host target would stretch them over the full surface.
+ * MotorStorm: Pacific Rift scales its 3D resolution with load (1280x720 down
+ * to well under it), renders into the corner of full-size targets and samples
+ * them as textures of the rendered size; viewed whole, the frame came out
+ * stretched with the unrendered right and bottom margins smeared over it.
+ * Returns a copy of the corner, refreshed when the target has been written
+ * since, or 0 to view the whole target as before. */
+static u32 eng_surface_corner(eng_surface* s, const rsx_dsp_texture* t)
+{
+    /* PS3RECOMP_ENG_CORNER=0: view the whole target, as before. */
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_CORNER"); on = !(e && *e == '0'); }
+    if (!on || !g.be->color_snapshot_rect || !(t->format & RSX_TEX_FMT_LINEAR) ||
+        t->cubemap || t->dimension == 3 || t->pitch != s->pitch ||
+        !t->width || !t->height || t->width > s->w || t->height > s->h ||
+        (t->width == s->w && t->height == s->h))
+        return 0;
+    if (!s->sub || s->sub_w != t->width || s->sub_h != t->height ||
+        s->sub_serial != s->color_serial) {
+        const u32 copy = g.be->color_snapshot_rect(g.be->user, s->handle, t->width, t->height);
+        if (!copy) return 0;
+        if (s->sub) g.be->texture_release(g.be->user, s->sub);
+        s->sub = copy; s->sub_w = t->width; s->sub_h = t->height;
+        if (EP_ON()) s_tx_real[0]++;
+        s->sub_serial = s->color_serial;
+    }
+    return s->sub;
