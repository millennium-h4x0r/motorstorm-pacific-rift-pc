+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_CORNER"); on = !(e && *e == '0'); }
+    if (!on || !g.be->color_snapshot_rect || !(t->format & RSX_TEX_FMT_LINEAR) ||
+        t->cubemap || t->dimension == 3 || t->pitch != s->pitch ||
+        !t->width || !t->height || t->width > s->w || t->height > s->h ||
+        (t->width == s->w && t->height == s->h))
