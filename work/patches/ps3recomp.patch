+    g.be->bind_pipeline(g.be->user, pipe);
+    g.be->bind_vs_constants(g.be->user, g.vp_cb, ENG_VP_CB_BYTES);
+    s_vs_bound_valid = 0;
+    g.be->bind_textures(g.be->user, tex, smp, 1u);
+    g.be->set_viewport(g.be->user, 0.0f, 0.0f, (float)t->width, (float)t->height);
+    g.be->set_scissor(g.be->user, 0, 0, t->width, t->height);
+    g.be->draw(g.be->user, RSX_TOPOLOGY_TRIANGLES, tri, 3, layout.stride, NULL, 0);
