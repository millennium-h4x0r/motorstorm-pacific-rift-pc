+            idx = xp;
+            ef_w16(q + LFQ_PUSH_RSV, (u16)(xp + 1 == ring ? 0 : xp + 1));
+            ef_line_end(q);
+            break;
+        }
+        ef_line_end(q);
+        if (!(flags & 1u)) return (s32)LFQ_ERR_AGAIN;
+        if (spins == 2000) {
+            static int _n = 0;
+            if (PS3_LOG_FIRST(_n, 8))
