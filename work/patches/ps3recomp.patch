+    c.gpr[3] = font; c.gpr[4] = code; c.gpr[5] = surf;
+    c.fpr[1] = x; c.fpr[2] = y;
+    c.gpr[6] = 0xDEAD0006; c.gpr[7] = 0xDEAD0007;   /* the GPR slots x and y take */
+    c.gpr[8] = metrics; c.gpr[9] = ti;
+    ctx_fn("cellFontRenderCharGlyphImage")(&c);
+    return (int32_t)c.gpr[3];
+}
+
+static int32_t call_scale(const char* name, uint32_t font, double w, double h)
+{
+    ppu_context c; memset(&c, 0, sizeof c);
+    c.gpr[3] = font; c.fpr[1] = w; c.fpr[2] = h;
+    ctx_fn(name)(&c);
+    return (int32_t)c.gpr[3];
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 2) { fprintf(stderr, "usage: %s <font.ttf>\n", argv[0]); return 2; }
+    g_font_host = argv[1];
+    vm_base = calloc(1, 16u << 20); assert(vm_base);
+    ppu_vm_size = 16u << 20;
+    ps3_font_register_ctx();
+    CHECK(ctx_fn("cellFontSetScalePixel") && ctx_fn("cellFontRenderCharGlyphImage")
+          && ctx_fn("cellFontSetupRenderScalePoint"));
+
+    /* Before init: every call is UNINITIALIZED. */
+    CHECK(cellFontInitLibraryFreeTypeWithRevision(0, FTCFG, LIBP) == (s32)CELL_FONT_ERROR_UNINITIALIZED);
+
+    /* CellFontConfig as fn 0x4FE524 fills it. */
+    vm_write32(CFG + 0x00, 0x30000); vm_write32(CFG + 0x04, 0x40000);
+    vm_write32(CFG + 0x08, 10); vm_write32(CFG + 0x0C, 0x31000); vm_write32(CFG + 0x10, 0);
+    CHECK(cellFontInitializeWithRevision(0x1234, CFG) == CELL_OK);
+    CHECK(cellFontInitializeWithRevision(0x1234, CFG) == (s32)CELL_FONT_ERROR_ALREADY_INITIALIZED);
+
+    /* CellFontLibraryConfigFT: library, MemoryIF {Object, Malloc, Free, Realloc, Calloc}. */
+    vm_write32(FTCFG + 0x00, 0);
+    vm_write32(FTCFG + 0x04, MIF_OBJ);
+    vm_write32(FTCFG + 0x08, OPD_MALLOC);
+    vm_write32(FTCFG + 0x0C, OPD_FREE);
+    vm_write32(FTCFG + 0x10, 0x1010);
+    vm_write32(FTCFG + 0x14, 0x1018);
+    CHECK(cellFontInitLibraryFreeTypeWithRevision(0x1234, FTCFG, LIBP) == CELL_OK);
+    const uint32_t lib = be32(LIBP);
+    CHECK(lib >= HEAP && lib < HEAP_END && g_mallocs == 1);
+    CHECK(be32(lib + 0) == 0 && be32(lib + 4) == 0);   /* libraryType, libraryVersion */
+
+    /* Fonts. */
+    strcpy((char*)vm_base + PATH, "/dev_bdvd/missing.ttf");
+    CHECK(cellFontOpenFontFile(lib, PATH, 0, 1, FONT) == (s32)CELL_FONT_ERROR_FONT_OPEN_FAILED);
+    strcpy((char*)vm_base + PATH, "/dev_bdvd/test.ttf");
+    CHECK(cellFontOpenFontFile(0x12340, PATH, 0, 1, FONT) == (s32)CELL_FONT_ERROR_INVALID_PARAMETER);
+    CHECK(cellFontOpenFontFile(lib, PATH, 0, 1, FONT) == CELL_OK);
+
+    const double S = 24.0;
+    CHECK(call_scale("cellFontSetScalePixel", FONT, S, S) == CELL_OK);
+    CHECK(bef(FONT + CELL_FONT_O_FONT_SCALE_X) == (float)S);
+
+    CHECK(cellFontGetHorizontalLayout(FONT, LAYOUT) == CELL_OK);
+    const float base = bef(LAYOUT + 0), line = bef(LAYOUT + 4);
+    printf("layout @%gpx: baseLineY %.2f lineHeight %.2f effectHeight %.2f\n",
+           S, base, line, bef(LAYOUT + 8));
+    CHECK(base > S * 0.5 && base < S * 1.5);
+    CHECK(line >= base && line < S * 2.5);
+
+    CHECK(cellFontGetCharGlyphMetrics(FONT, 'A', METR) == CELL_OK);
+    const float gw = bef(METR + 0), gh = bef(METR + 4), adv = bef(METR + 16);
+    printf("'A' @%gpx: %.2fx%.2f bearing (%.2f,%.2f) advance %.2f vadvance %.2f\n",
+           S, gw, gh, bef(METR + 8), bef(METR + 12), adv, bef(METR + 28));
+    CHECK(gw > 2 && gw < S && gh > S * 0.4 && gh < S);
+    CHECK(bef(METR + 12) > S * 0.4 && bef(METR + 12) <= gh + 1);   /* bearingY ~ cap height */
+    CHECK(adv > gw * 0.5 && adv < S * 1.5);
+
+    /* Half the scale: metrics scale with it. */
+    CHECK(call_scale("cellFontSetScalePixel", FONT, S / 2, S / 2) == CELL_OK);
+    CHECK(cellFontGetCharGlyphMetrics(FONT, 'A', METR) == CELL_OK);
+    CHECK(fabsf(bef(METR + 16) - adv / 2) < 1.0f);
+    CHECK(call_scale("cellFontSetScalePixel", FONT, S, S) == CELL_OK);
+
+    CHECK(cellFontGetCharGlyphMetrics(FONT, 0x10FFFD, METR) == (s32)CELL_FONT_ERROR_NO_SUPPORT_GLYPH);
+    CHECK(be32(METR + 0) == 0 && be32(METR + 16) == 0);
+
+    vm_write32(KERN, 0xFFFFFFFF); vm_write32(KERN + 4, 0xFFFFFFFF);
+    CHECK(cellFontGetKerning(FONT, 'A', 'V', KERN) == CELL_OK);
+    printf("kerning A,V: %.2f\n", bef(KERN));
+    CHECK(bef(KERN) <= 0.0f && bef(KERN) > -S && be32(KERN + 4) == 0);
+    CHECK(cellFontGetKerning(FONT, 0, 'V', KERN) == CELL_OK && be32(KERN) == 0);
+
+    /* Renderer: config all zero but expandSize, as the title passes it. */
+    vm_write32(RCFG + 0x0C, 1);
+    CHECK(cellFontCreateRenderer(lib, RCFG, REND) == CELL_OK);
+    CHECK(g_mallocs == 1);                 /* glyph buffer comes on first use */
+
+    /* NULL-buffer surface, 4x size, origin in the middle (fn 0x500700). */
+    const int32_t SZ = (int32_t)S * 4;
+    cellFontRenderSurfaceInit(SURF, 0, SZ, 1, SZ, SZ);
+    CHECK(be32(SURF + 0) == 0 && be32(SURF + 4) == (u32)SZ && be32(SURF + 8) == 1
+          && be32(SURF + 12) == (u32)SZ && be32(SURF + 16) == (u32)SZ
+          && be32(SURF + 0x1C) == (u32)SZ && be32(SURF + 0x20) == (u32)SZ);
+    cellFontRenderSurfaceSetScissor(SURF, 0, 0, SZ, SZ);
+    CHECK(call_scale("cellFontSetupRenderScalePoint", FONT, S, S) == CELL_OK);
+
+    CHECK(call_render(FONT, 'A', SURF, SZ / 2, SZ / 2, METR, TI) == (s32)CELL_FONT_ERROR_RENDERER_UNBIND);
+    CHECK(cellFontBindRenderer(FONT, REND) == CELL_OK);
+    CHECK(cellFontBindRenderer(FONT, REND) == (s32)CELL_FONT_ERROR_RENDERER_ALREADY_BIND);
+
+    CHECK(call_render(FONT, 'A', SURF, SZ / 2, SZ / 2, METR, TI) == CELL_OK);
+    const uint32_t img = be32(TI + 0), iwb = be32(TI + 4), iw = be32(TI + 8), ih = be32(TI + 12);
+    printf("'A' image 0x%08X %ux%u (stride %u), surface 0x%08X\n", img, iw, ih, iwb, be32(TI + 16));
+    CHECK(img >= HEAP && img < HEAP_END && g_mallocs == 2);
+    CHECK(iwb >= iw && fabsf((float)iw - gw) <= 2.0f && fabsf((float)ih - gh) <= 2.0f);
+    CHECK(be32(TI + 16) == 0 && be32(TI + 20) == (u32)SZ);
+    CHECK(bef(METR + 16) > 0);   /* metrics came back too */
+    {
+        unsigned ink = 0, full = 0;
+        for (uint32_t yy = 0; yy < ih; yy++)
+            for (uint32_t xx = 0; xx < iw; xx++) {
+                uint8_t a = vm_base[img + yy * iwb + xx];
+                ink += a != 0; full += a == 255;
+            }
+        printf("'A' coverage: %u of %u pixels inked, %u solid\n", ink, iw * ih, full);
+        CHECK(ink > iw * ih / 5 && full > 0 && ink < iw * ih);
+        for (uint32_t yy = 0; yy < ih; yy++) {      /* ASCII dump */
+            for (uint32_t xx = 0; xx < iw; xx++)
+                putchar(" .:-=+*#%@"[vm_base[img + yy * iwb + xx] * 9 / 255]);
+            putchar('\n');
+        }
+    }
+    /* A space has a glyph with no ink. */
+    CHECK(call_render(FONT, ' ', SURF, SZ / 2, SZ / 2, METR, TI) == CELL_OK);
+    CHECK(be32(TI + 8) == 0 && bef(METR + 16) > 0);
+
+    /* A surface with a buffer: the glyph lands inside it, at the origin. */
+    memset(vm_base + BUF2, 0x11, 64 * 64);
+    cellFontRenderSurfaceInit(SURF2, BUF2, 64, 1, 64, 64);
+    CHECK(call_render(FONT, 'O', SURF2, 8, 40, METR, TI) == CELL_OK);
+    {
+        const uint32_t im = be32(TI + 0), w = be32(TI + 8), h = be32(TI + 12);
+        CHECK(be32(TI + 4) == 64 && be32(TI + 16) == BUF2 && be32(TI + 20) == 64);
+        CHECK(im >= BUF2 && im < BUF2 + 64 * 64);
+        const uint32_t ox = (im - BUF2) % 64, oy = (im - BUF2) / 64;
+        printf("'O' in buffer at (%u,%u) %ux%u\n", ox, oy, w, h);
+        CHECK(ox >= 8 && ox < 8 + 4 && oy + h >= 39 && oy + h <= 42);   /* sits on the baseline */
+        CHECK(vm_base[BUF2] == 0x11);          /* outside the box: untouched */
+    }
+    /* Scissor clips. */
+    cellFontRenderSurfaceSetScissor(SURF2, 0, 0, 12, 64);
+    CHECK(call_render(FONT, 'O', SURF2, 8, 40, METR, TI) == CELL_OK);
+    CHECK(be32(TI + 8) <= 4);
+
+    CHECK(cellFontCloseFont(FONT) == CELL_OK);
+    CHECK(cellFontCloseFont(FONT) == (s32)CELL_FONT_ERROR_INVALID_PARAMETER);
+    CHECK(cellFontDestroyRenderer(REND) == CELL_OK && g_frees == 1);
+    CHECK(cellFontEndLibrary(lib) == CELL_OK && g_frees == 2);
+    CHECK(cellFontEnd() == CELL_OK);
+    CHECK(cellFontEnd() == (s32)CELL_FONT_ERROR_UNINITIALIZED);
+
+    printf("%s (%s): %d passed, %d failed\n", g_fail ? "FAIL" : "PASS", FONT_BACKEND,
+           g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
