+ * d.z first vertex of an array draw, d.w base index. The expansions are
+ * rsx_draw_engine_write_topology_indices's, one output vertex at a time. */
+"uint rsx_ref(uint vid) {\n"
+"    uint mode = (rsx_f.d.y >> 4) & 15u, n = vid;\n"
+"    uint t = vid / 3u, c = vid - t * 3u;\n"
+"    uint q = vid / 6u, k = vid - q * 6u;\n"
+"    if (mode == 1u) n = t + (c == 2u ? 2u : (c == 0u ? (t & 1u) : 1u - (t & 1u)));\n"
+"    else if (mode == 2u) n = c == 0u ? 0u : t + c;\n"
+"    else if (mode == 3u) n = 2u * q + (k < 3u ? k : (k == 3u ? 1u : (k == 4u ? 3u : 2u)));\n"
+"    else if (mode == 4u) n = 4u * q + (k < 3u ? k : (k == 3u ? 2u : (k == 4u ? 3u : 0u)));\n"
+"    uint it = rsx_f.d.y & 3u;\n"
+"    if (it == 1u) return rsx_be16(rsx_f.d.x + n * 2u);\n"
+"    if (it == 2u) return rsx_be32(rsx_f.d.x + n * 4u);\n"
+"    if (it == 3u) return vid;\n"
+"    return rsx_f.d.z + n;\n"
