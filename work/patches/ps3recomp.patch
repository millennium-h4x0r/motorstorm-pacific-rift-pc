+/* How many transform constants a decompiled vertex program reads: one past
+ * the highest vp_c[N], or all of them when it indexes relative to a0. */
+static u32 eng_vs_const_count(const char* hlsl)
+{
+    u32 n = 0;
+    for (const char* p = strstr(hlsl, "vp_c["); p; p = strstr(p + 5, "vp_c[")) {
+        const char* q = p + 5;
+        if (*q < '0' || *q > '9') return RSX_DSP_NUM_CONSTANTS;   /* relative */
+        u32 v = 0;
+        while (*q >= '0' && *q <= '9') v = v * 10u + (u32)(*q++ - '0');
+        if (*q != ']') return RSX_DSP_NUM_CONSTANTS;
+        if (v >= RSX_DSP_NUM_CONSTANTS) continue;   /* the declaration, vp_c[512] */
+        if (v + 1u > n) n = v + 1u;
+    }
+    return n > RSX_DSP_NUM_CONSTANTS ? RSX_DSP_NUM_CONSTANTS : n;
