@@ -0,0 +1,770 @@
+/*
+ * ps3recomp - a user interface over the game's window (Dear ImGui, Vulkan).
+ * See rsx_ui.h for the threads, rsx_ui_vk.h for the backend's side.
+ */
+#include "rsx_ui.h"
+#include "rsx_ui_vk.h"
+
+#include "imgui.h"
+#include "backends/imgui_impl_sdl2.h"
+#include "backends/imgui_impl_vulkan.h"
+
+#include <SDL2/SDL.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+extern "C" volatile int g_pad_ui_capture;   /* libs/input/cellPad.c: a neutral pad */
+
+namespace {
+
+#define UI_FN(X) X(vkCreateImageView) X(vkDestroyImageView) X(vkCreateFramebuffer) \
+    X(vkDestroyFramebuffer) X(vkCreateRenderPass) X(vkDestroyRenderPass)           \
+    X(vkCreateDescriptorPool) X(vkDestroyDescriptorPool) X(vkCmdBeginRenderPass)   \
+    X(vkCmdEndRenderPass) X(vkDeviceWaitIdle) X(vkCreateImage) X(vkDestroyImage)   \
+    X(vkGetImageMemoryRequirements) X(vkAllocateMemory) X(vkFreeMemory)            \
+    X(vkBindImageMemory) X(vkCreateBuffer) X(vkDestroyBuffer)                      \
+    X(vkGetBufferMemoryRequirements) X(vkBindBufferMemory) X(vkMapMemory)          \
+    X(vkCreateSampler) X(vkDestroySampler) X(vkCmdPipelineBarrier)                 \
+    X(vkCmdCopyBufferToImage) X(vkGetPhysicalDeviceMemoryProperties)              \
+    X(vkCmdCopyImageToBuffer) X(vkUnmapMemory)
+
+struct Ui {
+    std::mutex lock;                  /* the ImGui context and the copied draw data */
+    bool tried = false, imgui_vk = false;
+    std::atomic<bool> ok{false};      /* up, and not torn down or failed since */
+    void (*draw)(void*) = nullptr;
+    void* user = nullptr;
+    int (*hotkey)(int, void*) = nullptr;   /* the port's function keys (rsx_ui_set_hotkey) */
+    void* hotkey_user = nullptr;
+    std::atomic<int> menu{0}, visible{0}, modal{0};
+    std::atomic<bool> clear_input{false};  /* drop what ImGui held while it was hidden */
+    std::atomic<bool> reap{false};    /* the context outlived a teardown on another thread */
+    std::thread::id owner;            /* the window's thread: SDL and the context live there */
+
+    SDL_Window* window = nullptr;
+    rsx_ui_vk_info vk{};
+#define UI_DECL(n) PFN_##n n = nullptr;
+    UI_FN(UI_DECL)
+#undef UI_DECL
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    VkRenderPass rp = VK_NULL_HANDLE;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    std::vector<VkImageView> views;
+    std::vector<VkFramebuffer> fbs;
+    uint32_t w = 0, h = 0;
+
+    ImDrawData snap;                  /* the last frame, for the presenting thread */
+    std::vector<ImDrawList*> lists;
+    bool have_snap = false;
+
+    /* A picture for the port's screens (rsx_ui_set_image): the pixels wait
+     * here until the presenting thread's command buffer uploads them. */
+    struct {
+        std::vector<unsigned char> rgba;
+        int w = 0, h = 0;
+        bool want = false, ready = false;
+        VkImage img = VK_NULL_HANDLE;
+        VkDeviceMemory mem = VK_NULL_HANDLE, staging_mem = VK_NULL_HANDLE;
+        VkBuffer staging = VK_NULL_HANDLE;
+        VkImageView view = VK_NULL_HANDLE;
+        VkSampler sampler = VK_NULL_HANDLE;
+        VkDescriptorSet ds = VK_NULL_HANDLE;
+    } image;
+
+    /* PS3RECOMP_UI_SHOT=<file.ppm>: the swapchain image, UI and all, read
+     * back once after PS3RECOMP_UI_SHOT_AFTER (default 120) UI passes. The
+     * offscreen frame dump (PS3RECOMP_VK_DUMP) is taken before the UI. */
+    struct {
+        const char* path = nullptr;
+        long after = 120, passes = 0;
+        int state = 0;                /* 0 waiting, 1 copy recorded, 2 written */
+        bool src = false;             /* the swapchain was made with TRANSFER_SRC */
+        std::vector<VkImage> images;  /* the swapchain's */
+        VkBuffer buf = VK_NULL_HANDLE;
+        VkDeviceMemory mem = VK_NULL_HANDLE;
+        uint32_t w = 0, h = 0;
+    } shot;
+
+    std::chrono::steady_clock::time_point last{};
+    double dt = 0.0;
+    double hold = 0.0;                /* Select+Start held, seconds */
+    ImFont* title_font = nullptr;
+};
+/* On the heap and never freed: exit() runs from a guest thread while the rsx
+ * thread and the recording thread may still be in here. */
+Ui& U = *new Ui;
+
+PFN_vkVoidFunction ui_load(const char* name, void*)
+{
+    return U.vk.gipa(U.vk.instance, name);
+}
+
+void free_snap()
+{
+    for (ImDrawList* l : U.lists) IM_DELETE(l);
+    U.lists.clear();
+    U.snap.CmdLists.clear();
+    U.have_snap = false;
+}
+
+/* The SDL side and the context, on the window's thread, after a teardown
+ * elsewhere (rsx_ui_vk_shutdown) left them. Under U.lock. */
+void reap_locked()
+{
+    if (!U.reap || std::this_thread::get_id() != U.owner) return;
+    ImGui_ImplSDL2_Shutdown();
+    ImGui::DestroyContext();
+    U.reap = false;
+}
+
+void destroy_targets()
+{
+    for (VkFramebuffer f : U.fbs) U.vkDestroyFramebuffer(U.vk.device, f, nullptr);
+    for (VkImageView v : U.views) U.vkDestroyImageView(U.vk.device, v, nullptr);
+    U.fbs.clear(); U.views.clear();
+}
+
+/* A memory type with these bits and properties, or ~0u. */
+uint32_t mem_type(uint32_t bits, VkMemoryPropertyFlags want)
+{
+    VkPhysicalDeviceMemoryProperties mp;
+    U.vkGetPhysicalDeviceMemoryProperties(U.vk.phys, &mp);
+    for (uint32_t i = 0; i < mp.memoryTypeCount; i++)
+        if ((bits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & want) == want) return i;
+    return ~0u;
+}
+
+void image_release_locked()
+{
+    auto& im = U.image;
+    if (im.ds && U.imgui_vk) ImGui_ImplVulkan_RemoveTexture(im.ds);
+    if (im.sampler) U.vkDestroySampler(U.vk.device, im.sampler, nullptr);
+    if (im.view) U.vkDestroyImageView(U.vk.device, im.view, nullptr);
+    if (im.img) U.vkDestroyImage(U.vk.device, im.img, nullptr);
+    if (im.mem) U.vkFreeMemory(U.vk.device, im.mem, nullptr);
+    if (im.staging) U.vkDestroyBuffer(U.vk.device, im.staging, nullptr);
+    if (im.staging_mem) U.vkFreeMemory(U.vk.device, im.staging_mem, nullptr);
+    im.ds = VK_NULL_HANDLE; im.sampler = VK_NULL_HANDLE; im.view = VK_NULL_HANDLE;
+    im.img = VK_NULL_HANDLE; im.mem = VK_NULL_HANDLE;
+    im.staging = VK_NULL_HANDLE; im.staging_mem = VK_NULL_HANDLE;
+    im.ready = false;
+}
+
+/* The picture into a sampled image, recorded into `cb` ahead of the UI's
+ * render pass (the presenting thread owns the queue; nothing else submits
+ * for it). The staging buffer stays until the UI goes. Under U.lock. */
+void image_upload_locked(VkCommandBuffer cb)
+{
+    auto& im = U.image;
+    im.want = false;
+    const VkDeviceSize bytes = (VkDeviceSize)im.w * im.h * 4u;
+    const VkDevice dev = U.vk.device;
+    auto fail = [&](const char* what) {
+        fprintf(stderr, "[ui] the picture was not uploaded (%s)\n", what);
+        image_release_locked();
+    };
+    VkBufferCreateInfo bi = {};
+    bi.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    bi.size = bytes; bi.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (U.vkCreateBuffer(dev, &bi, nullptr, &im.staging) != VK_SUCCESS) return fail("buffer");
+    VkMemoryRequirements mr;
+    U.vkGetBufferMemoryRequirements(dev, im.staging, &mr);
+    VkMemoryAllocateInfo ai = {};
+    ai.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                                     VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (ai.memoryTypeIndex == ~0u || U.vkAllocateMemory(dev, &ai, nullptr, &im.staging_mem) != VK_SUCCESS ||
+        U.vkBindBufferMemory(dev, im.staging, im.staging_mem, 0) != VK_SUCCESS) return fail("staging memory");
+    void* map = nullptr;
+    if (U.vkMapMemory(dev, im.staging_mem, 0, bytes, 0, &map) != VK_SUCCESS) return fail("map");
+    memcpy(map, im.rgba.data(), (size_t)bytes);
+
+    VkImageCreateInfo ii = {};
+    ii.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    ii.imageType = VK_IMAGE_TYPE_2D; ii.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ii.extent = { (uint32_t)im.w, (uint32_t)im.h, 1 }; ii.mipLevels = 1; ii.arrayLayers = 1;
+    ii.samples = VK_SAMPLE_COUNT_1_BIT; ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ii.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    ii.sharingMode = VK_SHARING_MODE_EXCLUSIVE; ii.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (U.vkCreateImage(dev, &ii, nullptr, &im.img) != VK_SUCCESS) return fail("image");
+    U.vkGetImageMemoryRequirements(dev, im.img, &mr);
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (ai.memoryTypeIndex == ~0u || U.vkAllocateMemory(dev, &ai, nullptr, &im.mem) != VK_SUCCESS ||
+        U.vkBindImageMemory(dev, im.img, im.mem, 0) != VK_SUCCESS) return fail("image memory");
+
+    VkImageMemoryBarrier b = {};
+    b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = im.img; b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED; b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    b.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    U.vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                           0, nullptr, 0, nullptr, 1, &b);
+    VkBufferImageCopy c = {};
+    c.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    c.imageExtent = ii.extent;
+    U.vkCmdCopyBufferToImage(cb, im.staging, im.img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &c);
+    b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL; b.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    b.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT; b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    U.vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0,
+                           0, nullptr, 0, nullptr, 1, &b);
+
+    VkImageViewCreateInfo vi = {};
+    vi.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+    vi.image = im.img; vi.viewType = VK_IMAGE_VIEW_TYPE_2D; vi.format = ii.format;
+    vi.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    if (U.vkCreateImageView(dev, &vi, nullptr, &im.view) != VK_SUCCESS) return fail("view");
+    VkSamplerCreateInfo si = {};
+    si.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+    si.magFilter = si.minFilter = VK_FILTER_LINEAR;
+    si.addressModeU = si.addressModeV = si.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    si.maxLod = 1.0f;
+    if (U.vkCreateSampler(dev, &si, nullptr, &im.sampler) != VK_SUCCESS) return fail("sampler");
+    im.ds = ImGui_ImplVulkan_AddTexture(im.sampler, im.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    if (!im.ds) return fail("descriptor");
+    im.ready = true;
+}
+
+/* The screenshot's copy, recorded after the UI pass: the image goes from
+ * PRESENT_SRC to TRANSFER_SRC, into a host-visible buffer, and back. The
+ * caller waits for the submit before presenting, so the next pass may read
+ * the buffer. Under U.lock. */
+void shot_record_locked(VkCommandBuffer cb, uint32_t image)
+{
+    auto& sh = U.shot;
+    if (image >= sh.images.size()) return;
+    const VkDevice dev = U.vk.device;
+    const VkDeviceSize bytes = (VkDeviceSize)U.w * U.h * 4u;
+    VkBufferCreateInfo bi = {};
+    bi.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    bi.size = bytes; bi.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (U.vkCreateBuffer(dev, &bi, nullptr, &sh.buf) != VK_SUCCESS) { sh.state = 2; return; }
+    VkMemoryRequirements mr;
+    U.vkGetBufferMemoryRequirements(dev, sh.buf, &mr);
+    VkMemoryAllocateInfo ai = {};
+    ai.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                                     VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (ai.memoryTypeIndex == ~0u || U.vkAllocateMemory(dev, &ai, nullptr, &sh.mem) != VK_SUCCESS ||
+        U.vkBindBufferMemory(dev, sh.buf, sh.mem, 0) != VK_SUCCESS) {
+        fprintf(stderr, "[ui] screenshot: no memory\n");
+        sh.state = 2; return;
+    }
+    VkImageMemoryBarrier b = {};
+    b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = sh.images[image]; b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    b.oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR; b.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    b.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT; b.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    U.vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           0, 0, nullptr, 0, nullptr, 1, &b);
+    VkBufferImageCopy c = {};
+    c.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    c.imageExtent = { U.w, U.h, 1 };
+    U.vkCmdCopyImageToBuffer(cb, sh.images[image], VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, sh.buf, 1, &c);
+    b.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL; b.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+    b.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT; b.dstAccessMask = 0;
+    U.vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                           0, 0, nullptr, 0, nullptr, 1, &b);
+    sh.w = U.w; sh.h = U.h;
+    sh.state = 1;
+}
+
+/* The copy has landed (the submit it was in was waited on): write the PPM.
+ * Under U.lock. */
+void shot_write_locked()
+{
+    auto& sh = U.shot;
+    sh.state = 2;
+    void* map = nullptr;
+    if (U.vkMapMemory(U.vk.device, sh.mem, 0, VK_WHOLE_SIZE, 0, &map) == VK_SUCCESS) {
+        const bool bgr = U.format == VK_FORMAT_B8G8R8A8_UNORM || U.format == VK_FORMAT_B8G8R8A8_SRGB;
+        if (FILE* f = fopen(sh.path, "wb")) {
+            fprintf(f, "P6\n%u %u\n255\n", sh.w, sh.h);
+            const unsigned char* p = (const unsigned char*)map;
+            std::vector<unsigned char> row((size_t)sh.w * 3u);
+            for (uint32_t y = 0; y < sh.h; y++) {
+                for (uint32_t x = 0; x < sh.w; x++, p += 4) {
+                    row[x * 3 + 0] = bgr ? p[2] : p[0];
+                    row[x * 3 + 1] = p[1];
+                    row[x * 3 + 2] = bgr ? p[0] : p[2];
+                }
+                fwrite(row.data(), 1, row.size(), f);
+            }
+            fclose(f);
+            fprintf(stderr, "[ui] screenshot %ux%u (game frame + UI) written to %s\n", sh.w, sh.h, sh.path);
+        } else fprintf(stderr, "[ui] screenshot: cannot open %s\n", sh.path);
+        U.vkUnmapMemory(U.vk.device, sh.mem);
+    }
+    U.vkDestroyBuffer(U.vk.device, sh.buf, nullptr);
+    U.vkFreeMemory(U.vk.device, sh.mem, nullptr);
+    sh.buf = VK_NULL_HANDLE; sh.mem = VK_NULL_HANDLE;
+}
+
+/* The UI is over, for good (the window went, or a swapchain it cannot draw
+ * into): everything Vulkan goes now, the SDL side and the context on the
+ * window's thread, and the game gets its pad back. Under U.lock. */
+void teardown_locked()
+{
+    free_snap();
+    if (U.ok || U.imgui_vk) {
+        image_release_locked();
+        if (U.shot.buf) U.vkDestroyBuffer(U.vk.device, U.shot.buf, nullptr);
+        if (U.shot.mem) U.vkFreeMemory(U.vk.device, U.shot.mem, nullptr);
+        U.shot.buf = VK_NULL_HANDLE; U.shot.mem = VK_NULL_HANDLE;
+        if (U.shot.state == 1) U.shot.state = 0;
+        if (U.imgui_vk) ImGui_ImplVulkan_Shutdown();
+        destroy_targets();
+        if (U.rp) U.vkDestroyRenderPass(U.vk.device, U.rp, nullptr);
+        if (U.pool) U.vkDestroyDescriptorPool(U.vk.device, U.pool, nullptr);
+        U.reap = true;
+        reap_locked();
+    }
+    U.rp = VK_NULL_HANDLE; U.pool = VK_NULL_HANDLE;
+    U.ok = false; U.imgui_vk = false;
+    U.menu = 0; U.modal = 0; U.visible = 0;
+    g_pad_ui_capture = 0;
+}
+
+/* Whether anything is up to draw. */
+bool shown() { return U.visible || U.menu || U.modal; }
+
+/* The font: Inter where the system has it, ImGui's own otherwise. Baked
+ * large (RSX_UI_FONT_PX) and scaled down per frame to the window
+ * (io.FontGlobalScale, rsx_ui_frame), so a 720p window and a 4K screen read
+ * the same and going full screen needs no new atlas. */
+#define RSX_UI_FONT_PX 36.0f
+void load_fonts(ImGuiIO& io)
+{
+    const float px = RSX_UI_FONT_PX;
+    const char* env = getenv("PS3RECOMP_UI_FONT");
+    static const char* const paths[] = {
+        "/usr/share/fonts/rsms-inter-fonts/Inter-Medium.ttf",          /* Fedora */
+        "/usr/share/fonts/rsms-inter-fonts/Inter-Regular.ttf",
+        "/usr/share/fonts/truetype/inter/Inter-Medium.ttf",            /* Debian */
+        "/usr/share/fonts/inter/Inter-Medium.ttf",
+        "/usr/share/fonts/TTF/Inter-Medium.ttf",                       /* Arch */
+        "/usr/share/fonts/google-noto/NotoSans-Medium.ttf",
+        "/usr/share/fonts/noto/NotoSans-Medium.ttf",
+        "/usr/share/fonts/truetype/noto/NotoSans-Medium.ttf",
+    };
+    ImFontConfig cfg;
+    cfg.OversampleH = 2;
+    ImFont* f = nullptr;
+    if (env && *env) f = io.Fonts->AddFontFromFileTTF(env, px, &cfg, io.Fonts->GetGlyphRangesDefault());
+    for (const char* p : paths) {
+        if (f) break;
+        FILE* t = fopen(p, "rb");
+        if (!t) continue;
+        fclose(t);
+        f = io.Fonts->AddFontFromFileTTF(p, px, &cfg, io.Fonts->GetGlyphRangesDefault());
+    }
+    if (!f) {
+        ImFontConfig d; d.SizePixels = px;
+        io.Fonts->AddFontDefault(&d);
+    }
+    /* Titles: Inter Display Black where it exists, three times the size. */
+    static const char* const titles[] = {
+        "/usr/share/fonts/rsms-inter-fonts/InterDisplay-Black.ttf",
+        "/usr/share/fonts/rsms-inter-fonts/Inter-Black.ttf",
+        "/usr/share/fonts/truetype/inter/Inter-Black.ttf",
+        "/usr/share/fonts/inter/Inter-Black.ttf",
+        "/usr/share/fonts/TTF/Inter-Black.ttf",
+    };
+    for (const char* p : titles) {
+        FILE* t = fopen(p, "rb");
+        if (!t) continue;
+        fclose(t);
+        U.title_font = io.Fonts->AddFontFromFileTTF(p, px * 3.0f, &cfg, io.Fonts->GetGlyphRangesDefault());
+        break;
+    }
+}
+
+} /* namespace */
+
+extern "C" {
+
+void rsx_ui_set_draw(void (*draw)(void*), void* user)
+{
+    std::lock_guard<std::mutex> g(U.lock);
+    U.draw = draw; U.user = user;
+}
+
+void rsx_ui_set_hotkey(int (*fn)(int key, void* user), void* user)
+{
+    std::lock_guard<std::mutex> g(U.lock);
+    U.hotkey = fn; U.hotkey_user = user;
+}
+
+int rsx_ui_menu_open(void) { return U.menu.load(); }
+
+void rsx_ui_set_menu_open(int open)
+{
+    if (open && !U.menu) U.clear_input = true;
+    if ((open ? 1 : 0) != U.menu) fprintf(stderr, "[ui] menu %s\n", open ? "opened" : "closed");
+    U.menu = open ? 1 : 0;
+    g_pad_ui_capture = open ? 1 : 0;
+}
+
+void rsx_ui_set_visible(int visible)
+{
+    if (visible && !U.visible) U.clear_input = true;
+    U.visible = visible ? 1 : 0;
+}
+
+void rsx_ui_set_modal(int on)
+{
+    if (on && !U.modal) U.clear_input = true;
+    U.modal = on ? 1 : 0;
+}
+
+int rsx_ui_display_index(void)
+{
+    const int i = U.window ? SDL_GetWindowDisplayIndex(U.window) : 0;
+    return i < 0 ? 0 : i;
+}
+
+double rsx_ui_frame_dt(void) { return U.dt; }
+
+/* U.ok alone: the pipeline is rebuilt for a new swapchain format, and a start
+ * screen waiting on this must not take that moment for the end of the UI. */
+int rsx_ui_available(void) { return U.ok ? 1 : 0; }
+
+void* rsx_ui_title_font(void) { return U.title_font; }
+
+void rsx_ui_set_fullscreen(int on)
+{
+    if (U.window) SDL_SetWindowFullscreen(U.window, on ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+}
+
+int rsx_ui_fullscreen(void)
+{
+    return U.window && (SDL_GetWindowFlags(U.window) & SDL_WINDOW_FULLSCREEN) != 0;
+}
+
+void rsx_ui_set_image(const void* rgba, int w, int h)
+{
+    if (!rgba || w <= 0 || h <= 0 || w > 8192 || h > 8192) return;
+    std::lock_guard<std::mutex> g(U.lock);
+    if (U.image.ready || U.image.want) return;   /* one picture */
+    U.image.rgba.assign((const unsigned char*)rgba, (const unsigned char*)rgba + (size_t)w * h * 4u);
+    U.image.w = w; U.image.h = h;
+    U.image.want = true;
+}
+
+void* rsx_ui_image(int* w, int* h)
+{
+    /* Read on the rsx thread while it builds a frame, under U.lock already
+     * (the port's draw callback): no lock here. */
+    if (!U.image.ready || !U.image.ds) return nullptr;
+    if (w) *w = U.image.w;
+    if (h) *h = U.image.h;
+    return (void*)U.image.ds;
+}
+
+int rsx_ui_event(const void* ev)
+{
+    const SDL_Event* e = (const SDL_Event*)ev;
+    std::lock_guard<std::mutex> g(U.lock);
+    reap_locked();
+    if (!U.ok || !U.imgui_vk) return 0;
+    const bool key = e->type == SDL_KEYDOWN || e->type == SDL_KEYUP;
+    const SDL_Keycode sym = key ? e->key.keysym.sym : 0;
+    /* Full screen and back stay the window's, whatever is open. */
+    if (sym == SDLK_F11 || (sym == SDLK_RETURN && (e->key.keysym.mod & KMOD_ALT))) return 0;
+    /* A pad coming or going: ImGui rebuilds its list of pads only on these,
+     * so they go to it even while nothing is shown. They queue nothing. */
+    if (e->type == SDL_CONTROLLERDEVICEADDED || e->type == SDL_CONTROLLERDEVICEREMOVED) {
+        ImGui_ImplSDL2_ProcessEvent(e);
+        return 0;
+    }
+    /* A screen that owns the window (the start screen) takes every event:
+     * Escape would otherwise quit the game. */
+    if (U.modal) {
+        if (sym != SDLK_F1) ImGui_ImplSDL2_ProcessEvent(e);
+        return 1;
+    }
+    if (e->type == SDL_KEYDOWN && !e->key.repeat && sym == SDLK_F1) {
+        rsx_ui_set_menu_open(!U.menu);
+        return 1;
+    }
+    /* Escape closes the menu (and does not quit the game while it is open). */
+    if (U.menu && e->type == SDL_KEYDOWN && !e->key.repeat && sym == SDLK_ESCAPE) {
+        rsx_ui_set_menu_open(0);
+        return 1;
+    }
+    /* The port's own function keys (F10: the FPS counter). */
+    if (e->type == SDL_KEYDOWN && !e->key.repeat && U.hotkey &&
+        ((sym >= SDLK_F2 && sym <= SDLK_F10) || sym == SDLK_F12) && U.hotkey((int)sym, U.hotkey_user))
+        return 1;
+    /* Hidden, nothing reads the events: queued, they would replay into the
+     * menu the next time it opens. */
+    if (!shown()) return 0;
+    ImGui_ImplSDL2_ProcessEvent(e);
+    return U.menu ? 1 : 0;
+}
+
+void rsx_ui_frame(void)
+{
+    const auto now = std::chrono::steady_clock::now();
+    U.dt = U.last.time_since_epoch().count() ? std::chrono::duration<double>(now - U.last).count() : 0.0;
+    U.last = now;
+
+    std::lock_guard<std::mutex> g(U.lock);
+    reap_locked();
+    if (!U.ok || !U.imgui_vk) return;
+
+    /* Select+Start held half a second opens or closes the menu. */
+    /* Under SDL's joystick lock: cellPad opens and polls the same pads from
+     * the game's threads, and the device list behind SDL_NumJoysticks is
+     * rebuilt on each call (two threads at once corrupted the heap). */
+    if (!U.modal) { SDL_GameController* gc = nullptr;
+      SDL_LockJoysticks();
+      for (int i = 0; i < SDL_NumJoysticks() && !gc; i++)
+          if (SDL_IsGameController(i)) gc = SDL_GameControllerFromInstanceID(SDL_JoystickGetDeviceInstanceID(i));
+      const bool both = gc && SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_BACK) &&
+                        SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_START);
+      SDL_UnlockJoysticks();
+      if (both) {
+          const double before = U.hold;
+          U.hold += U.dt;
+          if (before < 0.5 && U.hold >= 0.5) rsx_ui_set_menu_open(!U.menu);
+      } else U.hold = 0.0; }
+
+    if (!U.draw || !shown()) { free_snap(); return; }
+    if (U.clear_input.exchange(false)) {
+        ImGuiIO& io = ImGui::GetIO();
+        io.ClearEventsQueue(); io.ClearInputKeys(); io.ClearInputMouse();
+    }
+    ImGui_ImplVulkan_NewFrame();
+    ImGui_ImplSDL2_NewFrame();
+    /* 20 px text on a 1080-line window, in proportion elsewhere. */
+    { ImGuiIO& io = ImGui::GetIO();
+      float sc = io.DisplaySize.y > 0 ? io.DisplaySize.y / 1080.0f * 20.0f / RSX_UI_FONT_PX : 0.55f;
+      io.FontGlobalScale = sc < 0.42f ? 0.42f : sc > 1.6f ? 1.6f : sc; }
+    ImGui::NewFrame();
+    U.draw(U.user);
+    ImGui::Render();
+    free_snap();
+    ImDrawData* d = ImGui::GetDrawData();
+    if (!d || !d->Valid || d->TotalVtxCount == 0) return;
+    U.snap = *d;
+    U.snap.CmdLists.clear();
+    for (ImDrawList* l : d->CmdLists) {
+        ImDrawList* c = l->CloneOutput();
+        U.lists.push_back(c);
+        U.snap.CmdLists.push_back(c);
+    }
+    U.have_snap = true;
+}
+
+int rsx_ui_vk_init(void* sdl_window, const rsx_ui_vk_info* info)
+{
+    if (U.tried) return U.ok ? 0 : -1;
+    U.tried = true;
+    { const char* e = getenv("PS3RECOMP_UI"); if (e && e[0] == '0') return -1; }
+    if (!sdl_window || !info || !info->gipa) return -1;
+    U.window = (SDL_Window*)sdl_window;
+    U.vk = *info;
+    U.owner = std::this_thread::get_id();
+#define UI_LOAD(n) if (!(U.n = (PFN_##n)U.vk.gipa(U.vk.instance, #n))) { fprintf(stderr, "[ui] no %s\n", #n); return -1; }
+    UI_FN(UI_LOAD)
+#undef UI_LOAD
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO& io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.LogFilename = nullptr;
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard | ImGuiConfigFlags_NavEnableGamepad;
+    load_fonts(io);
+    if (!ImGui_ImplSDL2_InitForVulkan(U.window) ||
+        !ImGui_ImplVulkan_LoadFunctions(ui_load, nullptr)) {
+        fprintf(stderr, "[ui] ImGui did not start: the game runs without its menu\n");
+        ImGui::DestroyContext();
+        return -1;
+    }
+    const VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 16 };
+    VkDescriptorPoolCreateInfo pci = {};
+    pci.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    pci.flags = VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT;
+    pci.maxSets = 16; pci.poolSizeCount = 1; pci.pPoolSizes = &ps;
+    if (U.vkCreateDescriptorPool(U.vk.device, &pci, nullptr, &U.pool) != VK_SUCCESS) {
+        ImGui_ImplSDL2_Shutdown(); ImGui::DestroyContext();
+        return -1;
+    }
+    U.ok = true;
+    /* PS3RECOMP_UI_OPEN=1: the menu is open from the start (a check that the
+     * overlay draws, with no hand on the keyboard). */
+    { const char* e = getenv("PS3RECOMP_UI_OPEN"); if (e && e[0] == '1') rsx_ui_set_menu_open(1); }
+    { const char* e = getenv("PS3RECOMP_UI_SHOT");
+      if (e && *e) {
+          U.shot.path = e;
+          const char* a = getenv("PS3RECOMP_UI_SHOT_AFTER");
+          if (a && *a) U.shot.after = atol(a);
+      } }
+    fprintf(stderr, "[ui] started: F1 (or Select+Start held) opens the menu, F10 the FPS counter\n");
+    return 0;
+}
+
+VkImageUsageFlags rsx_ui_vk_image_usage(VkImageUsageFlags supported)
+{
+    if (!U.ok || !(supported & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT)) return 0;
+    VkImageUsageFlags u = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    if (U.shot.path && U.shot.state == 0 && (supported & VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+        u |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    U.shot.src = (u & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) != 0;
+    return u;
+}
+
+void rsx_ui_vk_swapchain(VkFormat format, uint32_t count, const VkImage* images,
+                         uint32_t width, uint32_t height)
+{
+    if (!U.ok) return;
+    std::lock_guard<std::mutex> g(U.lock);
+    destroy_targets();
+    U.shot.images.clear();
+    if (!count) return;                 /* only letting go of the old images */
+    if (U.rp && U.format != format) {
+        /* Another format: the pipeline is the old render pass's, and the
+         * copied frame points at the font's descriptor set it frees. */
+        free_snap();
+        if (U.image.ds && U.imgui_vk) { ImGui_ImplVulkan_RemoveTexture(U.image.ds); U.image.ds = VK_NULL_HANDLE; }
+        if (U.imgui_vk) { ImGui_ImplVulkan_Shutdown(); U.imgui_vk = false; }
+        U.vkDestroyRenderPass(U.vk.device, U.rp, nullptr);
+        U.rp = VK_NULL_HANDLE;
+    }
+    U.format = format; U.w = width; U.h = height;
+    U.shot.images.assign(images, images + count);
+    if (!U.rp) {
+        VkAttachmentDescription at = {};
+        at.format = format;
+        at.samples = VK_SAMPLE_COUNT_1_BIT;
+        at.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        at.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        at.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        at.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        at.initialLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;   /* after the frame's blit */
+        at.finalLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+        VkAttachmentReference ref = { 0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL };
+        VkSubpassDescription sub = {};
+        sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        sub.colorAttachmentCount = 1; sub.pColorAttachments = &ref;
+        VkSubpassDependency dep[2] = {};
+        dep[0].srcSubpass = VK_SUBPASS_EXTERNAL; dep[0].dstSubpass = 0;
+        dep[0].srcStageMask = VK_PIPELINE_STAGE_TRANSFER_BIT;
+        dep[0].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        dep[0].dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+        dep[0].dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+        dep[1].srcSubpass = 0; dep[1].dstSubpass = VK_SUBPASS_EXTERNAL;
+        dep[1].srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+        dep[1].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+        dep[1].dstStageMask = VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT;
+        VkRenderPassCreateInfo rci = {};
+        rci.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+        rci.attachmentCount = 1; rci.pAttachments = &at;
+        rci.subpassCount = 1; rci.pSubpasses = &sub;
+        rci.dependencyCount = 2; rci.pDependencies = dep;
+        if (U.vkCreateRenderPass(U.vk.device, &rci, nullptr, &U.rp) != VK_SUCCESS) {
+            fprintf(stderr, "[ui] no render pass: the game runs without its menu\n");
+            U.rp = VK_NULL_HANDLE;
+            teardown_locked();
+            return;
+        }
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        VkImageViewCreateInfo vci = {};
+        vci.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+        vci.image = images[i];
+        vci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vci.format = format;
+        vci.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+        VkImageView v = VK_NULL_HANDLE;
+        if (U.vkCreateImageView(U.vk.device, &vci, nullptr, &v) != VK_SUCCESS) {
+            fprintf(stderr, "[ui] no image view: the game runs without its menu\n");
+            teardown_locked();
+            return;
+        }
+        U.views.push_back(v);
+        VkFramebufferCreateInfo fci = {};
+        fci.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+        fci.renderPass = U.rp; fci.attachmentCount = 1; fci.pAttachments = &v;
+        fci.width = width; fci.height = height; fci.layers = 1;
+        VkFramebuffer f = VK_NULL_HANDLE;
+        if (U.vkCreateFramebuffer(U.vk.device, &fci, nullptr, &f) != VK_SUCCESS) {
+            fprintf(stderr, "[ui] no framebuffer: the game runs without its menu\n");
+            teardown_locked();
+            return;
+        }
+        U.fbs.push_back(f);
+    }
+    if (!U.imgui_vk) {
+        ImGui_ImplVulkan_InitInfo ii = {};
+        ii.Instance = U.vk.instance; ii.PhysicalDevice = U.vk.phys; ii.Device = U.vk.device;
+        ii.QueueFamily = U.vk.queue_family; ii.Queue = U.vk.queue;
+        ii.DescriptorPool = U.pool; ii.RenderPass = U.rp;
+        ii.MinImageCount = count < 2 ? 2 : count;
+        ii.ImageCount = count < 2 ? 2 : count;
+        ii.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+        const bool init = ImGui_ImplVulkan_Init(&ii);
+        if (!init || !ImGui_ImplVulkan_CreateFontsTexture()) {
+            if (init) ImGui_ImplVulkan_Shutdown();
+            fprintf(stderr, "[ui] the ImGui pipeline did not build: the game runs without its menu\n");
+            teardown_locked();
+            return;
+        }
+        U.imgui_vk = true;
+        if (U.image.ready && !U.image.ds)   /* a new format: the picture's set went with the old pipeline */
+            U.image.ds = ImGui_ImplVulkan_AddTexture(U.image.sampler, U.image.view,
+                                                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+        fprintf(stderr, "[ui] ready (%ux%u, %u images)\n", width, height, count);
+    }
+}
+
+int rsx_ui_vk_record(VkCommandBuffer cb, uint32_t image)
+{
+    if (!shown()) return 0;
+    std::lock_guard<std::mutex> g(U.lock);
+    if (U.shot.state == 1) shot_write_locked();   /* the previous pass's copy */
+    if (!U.ok || !U.imgui_vk || !U.have_snap || image >= U.fbs.size()) return 0;
+    if (U.image.want && !U.image.ready) image_upload_locked(cb);
+    VkRenderPassBeginInfo bi = {};
+    bi.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+    bi.renderPass = U.rp;
+    bi.framebuffer = U.fbs[image];
+    bi.renderArea.extent = { U.w, U.h };
+    U.vkCmdBeginRenderPass(cb, &bi, VK_SUBPASS_CONTENTS_INLINE);
+    ImGui_ImplVulkan_RenderDrawData(&U.snap, cb);
+    U.vkCmdEndRenderPass(cb);
+    if (U.shot.path && U.shot.src && U.shot.state == 0 && ++U.shot.passes >= U.shot.after) shot_record_locked(cb, image);
+    return 1;
+}
+
+void rsx_ui_vk_shutdown(void)
+{
+    if (!U.tried) return;
+    std::lock_guard<std::mutex> g(U.lock);
+    /* A swapchain lost on the recording thread lands here on that one: the
+     * SDL side and the context wait for rsx_ui_reap on the window's. */
+    teardown_locked();
+}
+
+void rsx_ui_reap(void)
+{
+    if (!U.reap) return;
+    std::lock_guard<std::mutex> g(U.lock);
+    reap_locked();
+}
+
+} /* extern "C" */
diff --git a/libs/video/rsx_ui.h b/libs/video/rsx_ui.h
new file mode 100644
index 00000000..7c0bac4c
--- /dev/null
+++ b/libs/video/rsx_ui.h
@@ -0,0 +1,87 @@
+/*
+ * ps3recomp - a user interface over the game's window (Dear ImGui, Vulkan)
+ *
+ * The port's in-game menu (F1) and FPS counter are drawn with this. Only a
+ * windowed run (PS3RECOMP_VK_WINDOW=1) has a UI; offscreen runs never start it. The
+ * frame is built on the thread that owns the SDL window (the rsx thread:
+ * events and SDL calls stay there), copied, and recorded into the swapchain
+ * image by whichever thread presents the window, after the game frame's blit.
+ * What is drawn is the port's: it registers a callback (rsx_ui_set_draw) and
+ * makes ImGui calls in it.
+ */
+#ifndef PS3RECOMP_RSX_UI_H
+#define PS3RECOMP_RSX_UI_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The port's widgets, called once per UI frame between ImGui::NewFrame and
+ * ImGui::Render. */
+void rsx_ui_set_draw(void (*draw)(void* user), void* user);
+
+/* The port's function keys: F2-F10 and F12 key presses (SDL keycodes) go to
+ * `fn` on the window's thread while no modal screen is up; it returns 1 when
+ * it used the key. */
+void rsx_ui_set_hotkey(int (*fn)(int key, void* user), void* user);
+
+/* Rsx thread: an SDL event (const SDL_Event*). Returns 1 when the UI took it
+ * and the game should not see it. */
+int  rsx_ui_event(const void* sdl_event);
+
+/* Rsx thread: build one UI frame and keep a copy for the next window
+ * present. Cheap when nothing is shown. */
+void rsx_ui_frame(void);
+
+/* Whether the menu is open (the game gets a neutral pad), and opening or
+ * closing it. */
+int  rsx_ui_menu_open(void);
+void rsx_ui_set_menu_open(int open);
+
+/* Whether anything is drawn at all (the menu, the start screen, the FPS
+ * counter): the present skips the UI pass when not. */
+void rsx_ui_set_visible(int visible);
+
+/* A screen that owns the window (the start screen): every event goes to the
+ * UI, F1 and Select+Start do nothing, Escape does not quit. */
+void rsx_ui_set_modal(int on);
+
+/* The monitor the window is on (SDL's index). */
+int  rsx_ui_display_index(void);
+
+/* Seconds since the previous rsx_ui_frame, for the port's FPS counter and
+ * hold-to-open timing. */
+double rsx_ui_frame_dt(void);
+
+/* Whether the UI is up: started, and not failed or torn down since. A start
+ * screen gives up waiting when it is not. */
+int  rsx_ui_available(void);
+
+/* The window's thread, every event pump: finish a teardown another thread
+ * started (the SDL side and the ImGui context live on this one). */
+void rsx_ui_reap(void);
+
+/* A picture for the port's screens, RGBA8, copied: uploaded by the next
+ * present. One per run. */
+void rsx_ui_set_image(const void* rgba, int w, int h);
+
+/* The picture as an ImTextureID once it is on the GPU, else NULL. From the
+ * draw callback only. */
+void* rsx_ui_image(int* w, int* h);
+
+/* The large font for titles (ImFont*), or NULL: the regular one then. */
+void* rsx_ui_title_font(void);
+
+/* The window full screen (desktop resolution) or not, and its state now
+ * (F11 / Alt+Enter change it behind the menu's back). From the draw callback
+ * or the window's thread. */
+void rsx_ui_set_fullscreen(int on);
+int  rsx_ui_fullscreen(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/libs/video/rsx_ui_vk.h b/libs/video/rsx_ui_vk.h
new file mode 100644
index 00000000..c4705297
