# Allowlist: everything is ignored unless named below. The game, the dump,
# anything generated from it (lifted code, builds, logs, saves) and the
# toolkit clone never reach the repository.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CREDITS.md
!/version.txt
!/docs/
!/scripts/
!/work/

/work/*
!/work/port/
!/work/run.sh
!/work/tools/
!/work/tests/
!/work/patches/
/work/port/build*/
/work/port/spu/

__pycache__/
work/port/spu-*/
work/port/build-*.log

# Inside the allowlisted folders: compiled tools and anything the game or a
# run can leave behind (scripts/check_clean.sh refuses these as well).
/work/tools/tsample/tsample
*.o
*.so
*.a
*.log
*.elf
*.self
*.sprx
*.prx
*.bin
*.dat
*.psarc*
*.pkg
*.iso
*.rap
*.edat
*.sdat
*.sfo
*.ppm
*.png
*.wav
*.mp3
*.at3
*.bik
*.spv

# Gameplay recordings (work/tools/record.sh)
/recordings/
