+/* ---- decoded vertex cache ----------------------------------------------- */
+
+/* A race frame issues 2000-3500 draws, most of them static geometry whose
+ * vertex arrays and index buffers do not change from frame to frame, and
+ * decoding every referenced vertex into float4 attributes again each frame
+ * was the FIFO thread's largest cost (12-14 ms a frame). A draw's decoded
+ * vertices, and for an indexed draw the de-duplication map, depend only on:
+ * the attribute layout and each array's format, stride, offset, location
+ * and frequency, the per-attribute defaults, the reference list (the index
+ * data, after base index and restart cuts) and the guest bytes of every
+ * array over the element range the references touch. All of that is hashed
+ * (two independent 64-bit hashes, so a false hit needs both to collide) and
+ * a match reuses the stored result. The guest bytes are hashed, not trusted:
+ * CPU and SPU writes to vertex memory are invisible to the engine, and the
+ * hash reads the source at a few GB/s against the decode's few hundred MB/s.
+ * Inline vertex streams and attributes without a stable source range are not
+ * cached. PS3RECOMP_ENG_VCACHE=0 turns it off. */
+#define ENG_VCACHE_SETS   2048u
+#define ENG_VCACHE_WAYS   4u
+#define ENG_VCACHE_BYTES  (256u << 20)
+typedef struct {
+    u64 h1, h2;
+    u8* data;            /* verts, then occurrence_to_unique when remapped */
+    u32 vert_bytes, n_unique, n_source, remapped;
+    u32 last_frame;
+    u32* idx;            /* the rebuilt triangle-list indices, once drawn  */
+    u32 n_idx;
+} eng_vcache_entry;
+static eng_vcache_entry s_vcache[ENG_VCACHE_SETS][ENG_VCACHE_WAYS];
+static u64 s_vcache_bytes;
+static u64 s_vc_hits, s_vc_misses, s_vc_skips;
+static u64 s_vc_ns[4], s_vc_hashed;   /* refs, prepare, key, hit copy */
+
+typedef struct { u64 h1, h2; } eng_vhash;
