+/* Device-local image memory sub-allocated from 64 MB blocks (VK_SUBALLOC,
+ * default on). The race creates render targets and copies at sizes that
+ * follow the game's dynamic resolution, so the recycling pools miss and each
+ * new image cost a vkAllocateMemory/vkFreeMemory pair of kernel ioctls
+ * (~16% of the FIFO thread). Only optimal-tiling images live in these blocks,
+ * so buffer/image granularity never applies. First fit, ranges merged on free. */
+enum { VK_SUB_BLOCKS = 32, VK_SUB_RANGES = 512 };
+#define VK_SUB_BLOCK_BYTES (64ull << 20)
+typedef struct { VkDeviceSize off, size; } vk_sub_range;
+static struct { VkDeviceMemory mem; u32 type; VkDeviceSize size; u32 nfree; vk_sub_range fr[VK_SUB_RANGES]; } s_suballoc[VK_SUB_BLOCKS];
+static int vk_suballoc_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("VK_SUBALLOC"); on = !(e && *e == '0'); }
+    return on;
+}
+static int vk_sub_take(u32 b, VkDeviceSize size, VkDeviceSize align, VkDeviceSize* off)
+{
+    for (u32 i = 0; i < s_suballoc[b].nfree; i++) {
+        vk_sub_range* r = &s_suballoc[b].fr[i];
+        const VkDeviceSize a = (r->off + align - 1) / align * align;
+        if (a + size > r->off + r->size) continue;
+        const VkDeviceSize head = a - r->off, tail = r->off + r->size - (a + size);
+        if (head && tail) {                      /* split in two */
+            if (s_suballoc[b].nfree == VK_SUB_RANGES) continue;
+            memmove(&s_suballoc[b].fr[i + 2], &s_suballoc[b].fr[i + 1], (s_suballoc[b].nfree - i - 1) * sizeof *r);
+            s_suballoc[b].nfree++;
+            s_suballoc[b].fr[i + 1].off = a + size; s_suballoc[b].fr[i + 1].size = tail;
+            r->size = head;
+        } else if (head) { r->size = head; }
+        else if (tail)   { r->off = a + size; r->size = tail; }
+        else { memmove(r, r + 1, (s_suballoc[b].nfree - i - 1) * sizeof *r); s_suballoc[b].nfree--; }
+        *off = a;
+        return 1;
+    }
+    return 0;
+}
+static int vk_sub_alloc(u32 type, VkDeviceSize size, VkDeviceSize align, int* blk, VkDeviceSize* off, VkDeviceMemory* mem)
+{
+    if (size > VK_SUB_BLOCK_BYTES / 4) return 0;       /* big images keep their own allocation */
+    for (u32 b = 0; b < VK_SUB_BLOCKS; b++)
+        if (s_suballoc[b].mem && s_suballoc[b].type == type && vk_sub_take(b, size, align, off)) {
+            *blk = (int)b + 1; *mem = s_suballoc[b].mem; return 1;
+        }
+    for (u32 b = 0; b < VK_SUB_BLOCKS; b++) {
+        if (s_suballoc[b].mem) continue;
+        VkMemoryAllocateInfo mai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+                                     .allocationSize = VK_SUB_BLOCK_BYTES, .memoryTypeIndex = type };
+        if (pvkAllocateMemory(s_vk.device, &mai, NULL, &s_suballoc[b].mem) != VK_SUCCESS) {
+            s_suballoc[b].mem = VK_NULL_HANDLE; return 0;
+        }
+        s_suballoc[b].type = type; s_suballoc[b].size = VK_SUB_BLOCK_BYTES;
+        s_suballoc[b].nfree = 1; s_suballoc[b].fr[0].off = 0; s_suballoc[b].fr[0].size = VK_SUB_BLOCK_BYTES;
+        if (!vk_sub_take(b, size, align, off)) return 0;
+        *blk = (int)b + 1; *mem = s_suballoc[b].mem; return 1;
+    }
+    return 0;
+}
+static void vk_sub_free(int blk, VkDeviceSize off, VkDeviceSize size)
+{
+    if (blk <= 0 || blk > VK_SUB_BLOCKS || !size) return;
+    const u32 b = (u32)blk - 1;
+    u32 i = 0;
+    while (i < s_suballoc[b].nfree && s_suballoc[b].fr[i].off < off) i++;
+    /* merge with the previous and/or next free range */
+    int mprev = i > 0 && s_suballoc[b].fr[i - 1].off + s_suballoc[b].fr[i - 1].size == off;
+    int mnext = i < s_suballoc[b].nfree && off + size == s_suballoc[b].fr[i].off;
+    if (mprev && mnext) {
+        s_suballoc[b].fr[i - 1].size += size + s_suballoc[b].fr[i].size;
+        memmove(&s_suballoc[b].fr[i], &s_suballoc[b].fr[i + 1], (s_suballoc[b].nfree - i - 1) * sizeof(vk_sub_range));
+        s_suballoc[b].nfree--;
+    } else if (mprev) {
+        s_suballoc[b].fr[i - 1].size += size;
+    } else if (mnext) {
+        s_suballoc[b].fr[i].off = off; s_suballoc[b].fr[i].size += size;
+    } else if (s_suballoc[b].nfree < VK_SUB_RANGES) {
+        memmove(&s_suballoc[b].fr[i + 1], &s_suballoc[b].fr[i], (s_suballoc[b].nfree - i) * sizeof(vk_sub_range));
+        s_suballoc[b].fr[i].off = off; s_suballoc[b].fr[i].size = size;
+        s_suballoc[b].nfree++;
+    }   /* else: leak the range (table full), never a double use */
+}
