diff --git a/runtime/spu/tests/test_spu_coh_stress.c b/runtime/spu/tests/test_spu_coh_stress.c
new file mode 100644
index 00000000..ebdc43ba
--- /dev/null
+++ b/runtime/spu/tests/test_spu_coh_stress.c
@@ -0,0 +1,173 @@
+/*
+ * Stress test: PPU stores against SPU GETLLAR/PUTLLC loops on the same line.
+ *
+ * spu_coh_store_fast lets a PPU store to a line nobody currently holds skip
+ * the lock-line lock. Its correctness rests on a store-buffering ordering
+ * argument (spu_coherency.c, "Lines held now"): a store must never land
+ * between an SPU's GETLLAR copy and its PUTLLC commit without breaking that
+ * reservation. If it does, the PUTLLC writes the whole line back with the
+ * PPU's word as it was at the GETLLAR -- a lost PPU update.
+ *
+ * Here SPU threads increment their own word of a shared line in
+ * GETLLAR/PUTLLC retry loops (the same lock/reserve/copy/compare/commit/hold
+ * steps as spu_channels.c, through both the locked GETLLAR and
+ * spu_coh_reserve_fast), now and then hopping to a second line so the line's
+ * holder count keeps falling to zero and the fast path is really taken. A PPU
+ * thread stores a sequence into its own word of each line through the real
+ * ppu_memory.h vm_write32 and checks before every store that its previous
+ * value is still there. Any lost update shows up as a mismatch; at the end
+ * every SPU word must equal its count of successful PUTLLCs.
+ *
+ * Build:
+ *   clang -std=gnu17 -O2 -I include -I runtime/spu -pthread \
+ *         -o /tmp/test_spu_coh_stress runtime/spu/tests/test_spu_coh_stress.c
+ *   (STRESS_ITERS=<n> sets the PUTLLCs per SPU thread, default 200000.)
+ *
+ * Exit code: 0 if all passed, 1 if any failed.
+ */
+#include "../spu_coherency.c"
+#include "../../../tests/spu_ls_watch_fixture.h"
+#include "../../ppu/ppu_memory.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint8_t g_guest_mem[1u << 20];
+uint8_t* vm_base = g_guest_mem;
+
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi = 0;
+int      g_resv_store_active = 0;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width)
+{
+    (void)addr; (void)val; (void)width;
+}
+
+static unsigned long g_wakes;
+void spu_ch_wake(spu_context* ctx) { (void)ctx; __atomic_add_fetch(&g_wakes, 1, __ATOMIC_RELAXED); }
+
+static int g_pass, g_fail;
+#define CHECK(cond, ...) do { if (cond) g_pass++; else { g_fail++; \
+    fprintf(stderr, "FAIL: " __VA_ARGS__); fprintf(stderr, "\n"); } } while (0)
+
+#define LINE_A 0x00040000u
+#define LINE_B 0x00040400u
+#define NSPU   3
+
+static spu_context g_spu[NSPU];
+static unsigned long g_iters = 200000;
+static int g_spus_done;
+
+typedef struct { unsigned long ok, failed, fast_llar; } spu_stats;
+static spu_stats g_stats[NSPU];
+
+/* GETLLAR as spu_channels.c does it: the unlocked fast path for a registered
+ * holder of a marked line, otherwise lock + spu_coh_reserve. */
+static void getllar(spu_context* ctx, uint32_t ea, uint8_t* ls, spu_stats* st)
+{
+    const int fast = spu_coh_reserve_fast(ctx, ea);
+    if (!fast) { spu_lockline_lock(); spu_coh_reserve(ctx, ea); }
+    else st->fast_llar++;
+    memcpy(ls, vm_base + ea, 128);
+    memcpy(ctx->resv_line, ls, 128);
+    if (!fast) { ctx->resv_ea = ea; ctx->resv_valid = 1; spu_lockline_unlock(); }
+}
+
+static int putllc(spu_context* ctx, uint32_t ea, const uint8_t* ls)
+{
+    int ok = 0;
+    spu_lockline_lock();
+    if (ctx->resv_valid && ctx->resv_ea == ea &&
+        memcmp(vm_base + ea, ctx->resv_line, 128) == 0) {
+        /* A store landing here, after the compare, is the lost update; give
+         * one room to land (a commit is never this slow, a preempted one is). */
+        for (volatile int d = 0; d < 64; ++d) {}
+        memcpy(vm_base + ea, ls, 128);
+        ctx->resv_valid = 0;
+        spu_coh_notify_write_except(ea, ctx);
+        ok = 1;
+    }
+    ctx->resv_valid = 0;
+    spu_coh_hold(ctx, 0xFFFFFFFFu);
+    spu_lockline_unlock();
+    return ok;
+}
+
+static void* spu_thread(void* arg)
+{
+    const int i = (int)(intptr_t)arg;
+    spu_context* ctx = &g_spu[i];
+    spu_stats* st = &g_stats[i];
+    uint8_t ls[128];
+    unsigned rng = 0x9E3779B9u * (unsigned)(i + 1);
+    for (unsigned long n = 0; n < g_iters;) {
+        rng = rng * 1103515245u + 12345u;
+        const uint32_t ea = (rng >> 28) < 3 ? LINE_B : LINE_A;
+        getllar(ctx, ea, ls, st);
+        uint32_t w;
+        memcpy(&w, ls + 4 * (1 + i), 4);
+        w = __builtin_bswap32(__builtin_bswap32(w) + 1u);
+        memcpy(ls + 4 * (1 + i), &w, 4);
+        for (volatile int d = (int)((rng >> 8) & 63); d > 0; --d) {}  /* widen the window */
+        if (putllc(ctx, ea, ls)) { st->ok++; n++; }
+        else st->failed++;
+        if ((rng & 0xFF) == 0) {
+            /* A GETLLAR that is never committed (an SPU poll), left held. */
+            getllar(ctx, LINE_B, ls, st);
+        }
+    }
+    spu_coh_unregister(ctx);
+    __atomic_add_fetch(&g_spus_done, 1, __ATOMIC_SEQ_CST);
+    return NULL;
+}
+
+int main(void)
+{
+    const char* e = getenv("STRESS_ITERS");
+    if (e) g_iters = strtoul(e, NULL, 0);
+    for (int i = 0; i < NSPU; ++i) { spu_context_init(&g_spu[i], (uint32_t)i); }
+    /* Mark both lines once so the PPU stores consult the hold counts. */
+    spu_lockline_lock(); spu_coh_reserve(NULL, LINE_A); spu_coh_reserve(NULL, LINE_B); spu_lockline_unlock();
+
+    pthread_t t[NSPU];
+    for (int i = 0; i < NSPU; ++i) pthread_create(&t[i], NULL, spu_thread, (void*)(intptr_t)i);
+
+    /* The PPU: its own word (offset 0) of each line, a sequence, checked. */
+    uint32_t va = 0, vb = 0;
+    unsigned long lost = 0, stores = 0, first_lost_at = 0;
+    while (__atomic_load_n(&g_spus_done, __ATOMIC_SEQ_CST) < NSPU) {
+        if (vm_read32(LINE_A) != va) { if (!lost++) first_lost_at = stores; va = vm_read32(LINE_A); }
+        vm_write32(LINE_A, ++va);
+        if ((stores & 3) == 0) {
+            if (vm_read32(LINE_B) != vb) { if (!lost++) first_lost_at = stores; vb = vm_read32(LINE_B); }
+            vm_write32(LINE_B, ++vb);
+        }
+        stores++;
+    }
+    for (int i = 0; i < NSPU; ++i) pthread_join(t[i], NULL);
+
+    unsigned long ok = 0, failed = 0, fast = 0;
+    for (int i = 0; i < NSPU; ++i) {
+        const unsigned long got = vm_read32(LINE_A + 4u * (1 + i)) + vm_read32(LINE_B + 4u * (1 + i));
+        CHECK(got == g_stats[i].ok, "SPU %d: line words sum %lu, successful PUTLLCs %lu",
+              i, got, g_stats[i].ok);
+        ok += g_stats[i].ok; failed += g_stats[i].failed; fast += g_stats[i].fast_llar;
+    }
+    CHECK(lost == 0, "%lu PPU stores lost to a PUTLLC (first after %lu stores)", lost, first_lost_at);
+    CHECK(vm_read32(LINE_A) == va && vm_read32(LINE_B) == vb, "final PPU words");
+    CHECK(failed > 0, "no PUTLLC ever failed: the race was not exercised");
+    CHECK(g_wakes > 0, "no SPU_EVENT_LR wake was ever delivered");
+
+    /* With every holder gone, a store takes the fast path: no wake. */
+    const unsigned long w0 = g_wakes;
+    vm_write32(LINE_A, 1);
+    vm_write32(LINE_B, 1);
+    CHECK(g_wakes == w0 || !spu_coh_faststore_on(), "a store to an unheld line still woke someone");
+
+    printf("PPU stores %lu, PUTLLC ok %lu failed %lu, unlocked GETLLARs %lu, wakes %lu\n",
+           stores, ok, failed, fast, g_wakes);
+    printf("SPU lock-line stress tests: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail == 0 ? 0 : 1;
+}
