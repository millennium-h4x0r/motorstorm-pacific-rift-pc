 }
@@ -3479,3 +3477,137 @@ s32 cellSpursLFQueueAttachLv2EventQueue(u64 queue_ea)
     if (PS3_LOG_FIRST(_n, 8)) printf("[cellSpurs] LFQueueAttachLv2EventQueue(q=0x%08X)\n", (u32)queue_ea);
     return CELL_OK;
 }
+
+/* The mirror of cellSpursLFQueueAttachLv2EventQueue: there is no lv2 queue
+ * bound (waiters are woken through the taskset signal path), so accept. */
+s32 cellSpursLFQueueDetachLv2EventQueue(u64 queue_ea)
+{
+    static int _n = 0;
