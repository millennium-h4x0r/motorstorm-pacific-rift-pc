+/* RSX fragment temps alias: the fp32 register R[n] and the fp16 registers
+ * H[2n], H[2n+1] are the same 128 bits. R[n].x holds H[2n].x (low half) and
+ * H[2n].y (high half), R[n].y H[2n].zw, R[n].z H[2n+1].xy, R[n].w
+ * H[2n+1].zw (RPCS3 FragmentProgramDecompiler's gather/split). The
+ * translation keeps two separate arrays, so a program that writes one file
+ * and reads the other read zeros. MotorStorm: Pacific Rift packs its motion
+ * vectors that way -- velocity into h0.xy, then UP4UB of r0.x into an RGBA8
+ * target -- and read the bytes of an unrelated fp32 temp instead: the
+ * velocity buffer was noise and the motion blur smeared it over the frame.
+ *
+ * Only the registers a program actually crosses get the sync: one written
+ * in one file whose alias is read in the other. Bit m of *sync_r: a write to
+ * r[m/2] must refresh h[m]; bit m of *sync_h: a write to h[m] must refresh
+ * r[m/2]. Sources are counted whether or not the opcode reads them,
+ * which can only add a sync, never lose one. Same walk as the emitter: an
+ * instruction with a constant source is followed by its 16-byte literal. */
+static void fp_alias_sync_sets(const u8* ucode, u32 max_bytes, u64* sync_r, u64* sync_h)
+{
+    u64 wr_r = 0, wr_h = 0, rd_r = 0, rd_h = 0;
+    u32 off = 0;
+    while (off + 16 <= max_bytes) {
+        const u32 w0 = rsx_fp_read_word(ucode + off + 0);
+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        off += 16;
+        const u32 srcw[3] = { w1, w2, w3 };
+        int has_k = 0;
+        for (int i = 0; i < 3; i++) {
+            Src sr;
+            decode_src(srcw[i], 0, &sr);
+            if (sr.type == FP_REG_TYPE_CONST) has_k = 1;
+            if (!(w2 & FP_BRANCH) && sr.type == FP_REG_TYPE_TEMP && sr.index < 64) {
+                if (sr.half) rd_h |= 1ull << sr.index;
+                else         rd_r |= 1ull << sr.index;
+            }
+        }
+        if (has_k && off + 16 <= max_bytes) off += 16;
+        if (!(w2 & FP_BRANCH) && !(w0 & FP_OUT_NONE)) {
+            const u32 d = (w0 & FP_OUT_REG_MASK) >> FP_OUT_REG_SHIFT;
+            if (w0 & FP_OUT_HALF) wr_h |= 1ull << d;
+            else                  wr_r |= 1ull << d;
+        }
+        if (w0 & FP_END) break;
+    }
+    *sync_r = 0; *sync_h = 0;
+    for (u32 m = 0; m < 64; m++) {
+        if ((rd_h >> m & 1) && (wr_r >> (m / 2) & 1)) *sync_r |= 1ull << m;
+        if ((wr_h >> m & 1) && (rd_r >> (m / 2) & 1)) *sync_h |= 1ull << m;
+    }
+}
+
+/* The statements that carry a write to one file over to its alias in the
+ * other, for the components in `mask` (see fp_alias_sync_sets). */
+static void fp_emit_alias_sync(Out* o, int half, u32 idx, const char* mask,
+                               u64 sync_r, u64 sync_h)
+{
+    char line[256];
+    const int has_x = strchr(mask, 'x') != NULL, has_y = strchr(mask, 'y') != NULL;
+    const int has_z = strchr(mask, 'z') != NULL, has_w = strchr(mask, 'w') != NULL;
+    if (half) {
+        if (idx >= 64 || !(sync_h >> idx & 1) || idx / 2 >= 48) return;
+        static const char rc[4] = { 'x', 'y', 'z', 'w' };
+        const u32 n = idx / 2, base = (idx & 1u) * 2u;
+        if (has_x || has_y) {
+            snprintf(line, sizeof line,
+                     "    r[%u].%c = asfloat(f32tof16(h[%u].x) | (f32tof16(h[%u].y) << 16));\n",
+                     n, rc[base], idx, idx);
+            out_puts(o, line);
+        }
+        if (has_z || has_w) {
+            snprintf(line, sizeof line,
+                     "    r[%u].%c = asfloat(f32tof16(h[%u].z) | (f32tof16(h[%u].w) << 16));\n",
+                     n, rc[base + 1], idx, idx);
+            out_puts(o, line);
+        }
+    } else {
+        if (idx >= 32) return;
+        static const char* hp[4] = { "xy", "zw", "xy", "zw" };
+        static const char rc[4] = { 'x', 'y', 'z', 'w' };
+        const int has[4] = { has_x, has_y, has_z, has_w };
+        for (u32 c = 0; c < 4; c++) {
+            const u32 hi = idx * 2u + (c >> 1);
+            if (!has[c] || hi >= 48 || !(sync_r >> hi & 1)) continue;
+            snprintf(line, sizeof line,
+                     "    h[%u].%s = f16tof32(uint2(asuint(r[%u].%c) & 0xFFFFu, asuint(r[%u].%c) >> 16));\n",
+                     hi, hp[c], idx, rc[c], idx, rc[c]);
+            out_puts(o, line);
+        }
+    }
+}
