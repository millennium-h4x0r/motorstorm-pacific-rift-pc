+static eng_vcache_entry* eng_vcache_find(const eng_vhash* k)
+{
+    eng_vcache_entry* set = s_vcache[k->h1 & (ENG_VCACHE_SETS - 1u)];
+    for (u32 w = 0; w < ENG_VCACHE_WAYS; w++)
+        if (set[w].data && set[w].h1 == k->h1 && set[w].h2 == k->h2) return &set[w];
+    return NULL;
+}
+
+static eng_vcache_entry* eng_vcache_store(const eng_vhash* k, const u8* verts, u32 vert_bytes,
+                             u32 n_unique, u32 n_source, int remapped, const u32* remap)
+{
+    const u32 remap_bytes = remapped ? n_source * 4u : 0u;
+    if ((u64)vert_bytes + remap_bytes > (8u << 20)) return NULL;
+    eng_vcache_entry* set = s_vcache[k->h1 & (ENG_VCACHE_SETS - 1u)];
+    eng_vcache_entry* e = &set[0];
+    for (u32 w = 0; w < ENG_VCACHE_WAYS; w++) {
+        if (!set[w].data) { e = &set[w]; break; }
+        if (set[w].last_frame < e->last_frame) e = &set[w];
+    }
+    if (e->data) {
+        s_vcache_bytes -= e->vert_bytes + (e->remapped ? e->n_source * 4u : 0u) + e->n_idx * 4u;
+        free(e->data); e->data = NULL;
+        free(e->idx); e->idx = NULL; e->n_idx = 0;
+    }
+    if (s_vcache_bytes + vert_bytes + remap_bytes > ENG_VCACHE_BYTES) return NULL;
+    u8* d = (u8*)malloc((size_t)vert_bytes + remap_bytes);
+    if (!d) return NULL;
+    memcpy(d, verts, vert_bytes);
+    if (remap_bytes) memcpy(d + vert_bytes, remap, remap_bytes);
+    e->h1 = k->h1; e->h2 = k->h2; e->data = d;
+    e->vert_bytes = vert_bytes; e->n_unique = n_unique; e->n_source = n_source;
+    e->remapped = (u32)(remapped != 0); e->last_frame = g.frames;
+    s_vcache_bytes += vert_bytes + remap_bytes;
+    return e;
+}
+
+static void eng_vcache_clear(void)
+{
+    for (u32 i = 0; i < ENG_VCACHE_SETS; i++)
+        for (u32 w = 0; w < ENG_VCACHE_WAYS; w++) {
+            free(s_vcache[i][w].data);
+            s_vcache[i][w].data = NULL;
+            free(s_vcache[i][w].idx);
+            s_vcache[i][w].idx = NULL;
+            s_vcache[i][w].n_idx = 0;
+        }
