+static int eng_vs_to_fetch(char* hlsl, size_t cap)
+{
+    char* in0 = strstr(hlsl, "struct VSInput {\n");
+    char* in1 = in0 ? strstr(in0, "};\n") : NULL;
+    char* mainp = strstr(hlsl, "VSOutput main(VSInput input) {\n");
+    if (!in0 || !in1 || !mainp || mainp < in1) return -1;
+    static char out[256 * 1024];
+    size_t o = 0;
+#define GF_PUT(p, n) do { size_t _n = (n); if (o + _n >= sizeof out) return -1; memcpy(out + o, (p), _n); o += _n; } while (0)
+    GF_PUT(hlsl, (size_t)(in0 - hlsl));
+    GF_PUT(kEngFetchPreamble, sizeof kEngFetchPreamble - 1u);
+    static const char vin[] = "struct VSInput {\n    uint vid:SV_VertexID;\n};\n";
+    GF_PUT(vin, sizeof vin - 1u);
+    const char* rest = in1 + 3;
+    const char* mbody = mainp + strlen("VSOutput main(VSInput input) {\n");
+    GF_PUT(rest, (size_t)(mbody - rest));
+    static const char vtx[] = "    uint _vtx = rsx_ref(input.vid);\n";
+    GF_PUT(vtx, sizeof vtx - 1u);
+    /* In main, the viewport epilogue reads its scale and offset from the push
+     * block (rsx_f.ps/po): a pull draw binds only the constants its program
+     * reads (eng_vs_const_count), which ends before the cbuffer's tail. */
