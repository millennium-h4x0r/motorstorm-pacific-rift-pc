+static void (*ctx_fn(const char* name))(ppu_context*)
+{
+    const uint32_t nid = ps3_compute_nid(name);
+    for (int i = 0; i < g_nctx; i++) if (g_ctx[i].nid == nid) return g_ctx[i].fn;
