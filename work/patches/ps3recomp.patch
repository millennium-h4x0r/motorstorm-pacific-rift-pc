+        const char* hit = strstr(p, "input.a");
+        const char* hs = strstr(p, "vp_posscale");
+        const char* ho = strstr(p, "vp_posoffset");
+        const char* hx = hs && (!ho || hs < ho) ? hs : ho;
+        if (hx && (!hit || hx < hit)) {
+            GF_PUT(p, (size_t)(hx - p));
+            if (hx == hs) { GF_PUT("rsx_f.ps", 8); p = hx + 11; }
+            else          { GF_PUT("rsx_f.po", 8); p = hx + 12; }
+            continue;
+        }
+        if (!hit) { GF_PUT(p, strlen(p)); break; }
+        GF_PUT(p, (size_t)(hit - p));
+        const char* q = hit + 7;
+        u32 k = 0; int digits = 0;
+        while (*q >= '0' && *q <= '9') { k = k * 10u + (u32)(*q - '0'); q++; digits++; }
+        if (!digits || k > 15u) return -1;
+        char call[32];
+        const int n = snprintf(call, sizeof call, "rsx_attr(%uu, _vtx)", k);
+        GF_PUT(call, (size_t)n);
+        p = q;
+    }
+#undef GF_PUT
+    if (o + 1u > cap) return -1;
+    memcpy(hlsl, out, o);
+    hlsl[o] = 0;
+    return 0;
