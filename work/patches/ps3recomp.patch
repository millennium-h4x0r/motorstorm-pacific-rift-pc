+static _Alignas(64) _Atomic int s_ar_prod_sleeping;
+static unsigned long long s_ar_rec_ns, s_ar_drains, s_ar_cmds;
+
+static int vk_ar_active(void) { return s_ar_on == 1; }
+
+/* ---- virtual handles (producer side) ---- */
+/* A freed id is reused only once the recorder has executed past the command
+ * that released it (that command still translates through the old entry). */
+enum { AR_PEND = 1u << 16 };
+static struct { u32 id; size_t pos; } s_ar_pend[AR_PEND];
+static u32 s_ar_pend_r, s_ar_pend_w;
+static void ar_pend_reap(void)
+{
+    const size_t tail = atomic_load_explicit(&s_ar_tail, memory_order_acquire);
+    while (s_ar_pend_r != s_ar_pend_w && s_ar_pend[s_ar_pend_r % AR_PEND].pos <= tail) {
+        if (s_ar_nfree < VK_AR_IDS) s_ar_free[s_ar_nfree++] = s_ar_pend[s_ar_pend_r % AR_PEND].id;
+        s_ar_pend_r++;
+    }
+}
+/* Producer side: which persistent ids are handed out. The engine releases
+ * some handles twice (a depth target's snapshot on reallocation); the second
+ * release of an id must not queue it for reuse again. */
+static u8 s_ar_live[VK_AR_IDS];
+static u32 ar_vnew(void)
+{
+    if (!s_ar_nfree) ar_pend_reap();
+    u32 id = s_ar_nfree ? s_ar_free[--s_ar_nfree] : (s_ar_next < VK_AR_IDS ? s_ar_next++ : 0);
+    if (!id) return 0;
+    atomic_store_explicit(&s_ar_vt[id], 0, memory_order_relaxed);
+    s_ar_live[id] = 1;
+    return VK_AR_VBIT | id;
+}
+static int ar_vlive(u32 v)
+{
+    const u32 id = v & ~VK_AR_VBIT;
+    return !(v & VK_AR_VBIT) || id >= VK_AR_IDS || s_ar_live[id];
+}
+static u32 ar_vtrans(void)
+{
+    const u32 id = VK_AR_IDS + (s_ar_tnext++ & (VK_AR_TRANS - 1));
+    atomic_store_explicit(&s_ar_vt[id], 0, memory_order_relaxed);
+    return VK_AR_VBIT | id;
+}
+static void ar_vfree(u32 v)
+{
+    if (!(v & VK_AR_VBIT)) return;
+    const u32 id = v & ~VK_AR_VBIT;
+    if (!id || id >= VK_AR_IDS || !s_ar_live[id]) return;
+    s_ar_live[id] = 0;
+    if (s_ar_pend_w - s_ar_pend_r == AR_PEND) return;          /* full: leak the id, never misuse it */
+    s_ar_pend[s_ar_pend_w % AR_PEND].id = id;
+    s_ar_pend[s_ar_pend_w % AR_PEND].pos = atomic_load_explicit(&s_ar_head, memory_order_relaxed);
+    s_ar_pend_w++;
+}
+/* recorder side: virtual -> real (0 when the create failed) */
+static inline u32 ar_x(u32 h)
+{
+    if (!(h & VK_AR_VBIT)) return h;
+    const u32 id = h & ~VK_AR_VBIT;
+    if (id >= VK_AR_IDS + VK_AR_TRANS) return 0;
+    return atomic_load_explicit(&s_ar_vt[id], memory_order_acquire) & ~VK_AR_DONE;
+}
+static u8 s_ar_vop[VK_AR_IDS + VK_AR_TRANS];   /* VK_DUMMY_LOG: op that set each virtual id (recorder) */
+static u32 s_ar_cur_op;
+static inline void ar_set(u32 v, u32 real)
+{
+    if (v & VK_AR_VBIT) {
+        if ((v & ~VK_AR_VBIT) < VK_AR_IDS + VK_AR_TRANS) s_ar_vop[v & ~VK_AR_VBIT] = (u8)s_ar_cur_op;
+        atomic_store_explicit(&s_ar_vt[v & ~VK_AR_VBIT], real | VK_AR_DONE, memory_order_release);
+    }
+}
+
+/* surface_view results, cached producer-side so a view is one virtual id per
+ * (surface, remap, format), as the backend caches the real view; dropped when
+ * the surface is released (the backend destroys its views then). */
+enum { AR_VIEWS = 8192 };
+static struct { u32 surface, remap, fmt, v; } s_ar_views[AR_VIEWS];
+static u32 s_ar_nviews;
+
+/* fetch_serial through the proxy. Proxy serials are markers in the ring: the
+ * recorder, on reaching marker t, stores the backend's own serial covering
+ * everything before it (s_ar_fsr[t]). A proxy serial is complete once its
+ * marker has been executed and the backend's completed serial has reached the
+ * stored one. Markers are queued at most every 256 commands, or when the
+ * previous one has been executed, so a caller waiting for completion always
+ * sees progress. */
+#define AR_FSR_N 65536u
+static _Atomic unsigned long long s_ar_fsr[AR_FSR_N];
+static _Alignas(64) _Atomic unsigned long long s_ar_fs_exec;     /* last marker executed */
+static _Alignas(64) _Atomic unsigned long long s_ar_real_done;   /* backend's completed serial, last seen */
+static unsigned long long s_ar_pe, s_ar_pdone;                    /* producer: last marker queued, last known complete */
+static unsigned s_ar_since_marker;
+
+/* Redundant state calls are dropped producer-side: the engine sets viewport,
+ * scissor, stencil, depth bounds, targets, pipeline and textures before every
+ * draw, and most are what the backend already has (its state persists between
+ * draws). Reset whenever a handle is released (its virtual id may come back as
+ * a different object). */
+static struct {
+    int vp_ok, sc_ok, st_ok, db_ok, bp_ok, bt_ok, tex_ok, vtex_ok;
+    ar_f4 vp; ar_u4 sc; u32 st; float db[2]; u32 bp; u32 bt[RSX_BE_MAX_COLOR_TARGETS + 2];
+    u32 tex_mask, tex_has_samp, tex[RSX_BE_MAX_TEXTURES]; rsx_be_sampler_desc samp[RSX_BE_MAX_TEXTURES];
+    u32 vtex_mask, vtex_has_samp, vtex[RSX_BE_MAX_TEXTURES]; rsx_be_sampler_desc vsamp[RSX_BE_MAX_TEXTURES];
+} s_ar_st;
+static int ar_dedupe_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("VK_AR_DEDUPE"); on = !(e && *e == '0'); }
+    return on;
+}
+
+/* ---- the ring ---- */
+static void ar_wake_recorder(void)
+{
+    if (atomic_load_explicit(&s_ar_rec_sleeping, memory_order_acquire)) {
+        pthread_mutex_lock(&s_ar_qmu); pthread_cond_broadcast(&s_ar_qcv); pthread_mutex_unlock(&s_ar_qmu);
+    }
+}
+static void ar_wait_space(size_t need)
+{
+    const size_t head0 = atomic_load_explicit(&s_ar_head, memory_order_relaxed);
+    if (VK_AR_RING - (head0 - s_ar_tail_seen) >= need) return;      /* no shared read needed */
+    for (int spin = 0;; spin++) {
+        const size_t head = atomic_load_explicit(&s_ar_head, memory_order_relaxed);
+        const size_t tail = atomic_load_explicit(&s_ar_tail, memory_order_acquire);
+        s_ar_tail_seen = tail;
+        if (VK_AR_RING - (head - tail) >= need) return;
+        ar_wake_recorder();
+        if (spin < 200) { __builtin_ia32_pause(); continue; }
+        pthread_mutex_lock(&s_ar_qmu);
+        atomic_store(&s_ar_prod_sleeping, 1);
+        if (VK_AR_RING - (atomic_load(&s_ar_head) - atomic_load(&s_ar_tail)) < need) {
+            struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_nsec += 1000000;
+            if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+            pthread_cond_timedwait(&s_ar_qcv, &s_ar_qmu, &ts);
+        }
+        atomic_store(&s_ar_prod_sleeping, 0);
+        pthread_mutex_unlock(&s_ar_qmu);
+    }
+}
+/* Reserve a command of `payload` bytes after the header; returns the payload. */
+static void* ar_begin(u32 op, size_t payload)
+{
+    const size_t size = (sizeof(ar_hdr) + payload + 15u) & ~(size_t)15u;
+    size_t head = atomic_load_explicit(&s_ar_head, memory_order_relaxed);
+    size_t off = head % VK_AR_RING;
+    if (off + size > VK_AR_RING) {               /* no room before the end: wrap */
+        ar_wait_space(VK_AR_RING - off + size);
+        ar_hdr* w = (ar_hdr*)(s_ar_ring + off);
+        w->op = AR_WRAP; w->size = (u32)(VK_AR_RING - off);
+        head += VK_AR_RING - off;
+        atomic_store_explicit(&s_ar_head, head, memory_order_release);
+        off = 0;
+    } else {
+        ar_wait_space(size);
+    }
+    ar_hdr* h = (ar_hdr*)(s_ar_ring + off);
+    h->op = op; h->size = (u32)size;
+    s_ar_pending_size = size;
+    return h + 1;
+}
+static void ar_commit(void)
+{
+    atomic_store_explicit(&s_ar_head, atomic_load_explicit(&s_ar_head, memory_order_relaxed) + s_ar_pending_size,
+                          memory_order_release);
+    s_ar_cmds++;
+    s_ar_since_marker++;
+    ar_wake_recorder();
+}
+/* Wait until the recorder has executed everything queued, then hold s_ar_mu. */
+static void vk_ar_drain_lock(void)
+{
+    if (!vk_ar_active()) { pthread_mutex_lock(&s_ar_mu); return; }
+    s_ar_drains++;
+    {   static int st = -1; if (st < 0) st = getenv("VK_AR_STATS") ? 1 : 0;
+        if (st) { static unsigned n; if ((n++ & 63) == 0)
+            fprintf(stderr, "[vk-ar] drain from %p\n", __builtin_return_address(0)); } }
+    for (int spin = 0;; spin++) {
+        if (atomic_load_explicit(&s_ar_tail, memory_order_acquire) == atomic_load_explicit(&s_ar_head, memory_order_relaxed) &&
+            !atomic_load_explicit(&s_ar_busy, memory_order_acquire))
+            break;
+        ar_wake_recorder();
+        if (spin < 200) __builtin_ia32_pause();
+        else {
+            pthread_mutex_lock(&s_ar_qmu);
+            atomic_store(&s_ar_prod_sleeping, 1);
+            if (!(atomic_load(&s_ar_tail) == atomic_load(&s_ar_head) && !atomic_load(&s_ar_busy))) {
+                struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_nsec += 200000;
+                if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+                pthread_cond_timedwait(&s_ar_qcv, &s_ar_qmu, &ts);
+            }
+            atomic_store(&s_ar_prod_sleeping, 0);
+            pthread_mutex_unlock(&s_ar_qmu);
+        }
+    }
+    pthread_mutex_lock(&s_ar_mu);
+}
+static void vk_ar_unlock(void) { pthread_mutex_unlock(&s_ar_mu); }
+
+/* Entry points from outside the engine (window pump, UI, present finish). */
+static void vk_ar_lock(void) { if (s_ar_on == 1) pthread_mutex_lock(&s_ar_mu); }
+static void vk_ar_unlock_ext(void) { if (s_ar_on == 1) pthread_mutex_unlock(&s_ar_mu); }
+
+/* ---- payload structs ---- */
+typedef struct { u32 v; rsx_be_format fmt; u32 w, h, mips, faces, remap, rsx_fmt; } ar_texc;
+typedef struct { u32 tex, face, mip, w, h, row_bytes, rows; } ar_texu;
+typedef struct { u32 kind, h; } ar_rel;
+typedef struct { u32 v; rsx_be_format fmt; u32 w, h, seed_row_bytes, has_seed; } ar_ctc;
+typedef struct { u32 surface, x, y, w, h, row_bytes; } ar_ctw;
+typedef struct { u32 v, surface, remap, fmt; } ar_view;
+typedef struct { u32 v, w, h; } ar_dtc;
+typedef struct { u32 v, depth, w, h; } ar_dsnap;
+typedef struct { u32 v, vs_len, ps_len, has_rs, has_layout, stride, rt_count; rsx_be_format rt_fmt;
+                 rsx_be_render_state rs; rsx_vertex_layout_plan layout; } ar_pipe;
+typedef struct { u32 count, depth, s[RSX_BE_MAX_COLOR_TARGETS]; } ar_bt;
+typedef struct { u32 mask, has_samp; u32 tex[RSX_BE_MAX_TEXTURES]; rsx_be_sampler_desc samp[RSX_BE_MAX_TEXTURES]; } ar_btex;
+typedef struct { rsx_topology topo; u32 vcount, stride, icount; } ar_draw;
+typedef struct { u32 surface; float rgba[4]; } ar_clrc;
+typedef struct { u32 depth, flags; float dv; u32 stencil; } ar_clrd;
+typedef struct { u32 v; rsx_be_format fmt; u32 w, h, depth, mips, remap, rsx_fmt; } ar_tex3c;
+typedef struct { u32 tex, z, mip, w, h, row_bytes; } ar_tex3u;
+typedef struct { u32 surface; float rgba[4]; u32 x, y, w, h; } ar_clrcr;
+typedef struct { u32 depth, flags; float dv; u32 stencil, x, y, w, h; } ar_clrdr;
+typedef struct { u32 v, surface, w, h; } ar_csnap;
+typedef struct { u32 v, surface, x, y, w, h; } ar_rba;
+
+/* ---- recorder ---- */
+static void ar_exec(const ar_hdr* hd)
+{
+    const rsx_draw_backend* b = s_ar_in;
+    void* u = b->user;
+    const void* p = hd + 1;
+    s_ar_cur_op = hd->op;
+    switch (hd->op) {
+    case AR_TEXC: { const ar_texc* a = p;
+        ar_set(a->v, b->texture_create(u, a->fmt, a->w, a->h, a->mips, a->faces, a->remap, a->rsx_fmt)); break; }
+    case AR_TEXU: { const ar_texu* a = p;
+        b->texture_upload(u, ar_x(a->tex), a->face, a->mip, a->w, a->h, a + 1, a->row_bytes, a->rows); break; }
+    case AR_REL: { const ar_rel* a = p; const u32 r = ar_x(a->h);
+        if (r) {
+            if (a->kind == AR_REL_TEX) b->texture_release(u, r);
+            else if (a->kind == AR_REL_CT) b->color_target_release(u, r);
+            else if (a->kind == AR_REL_DT) b->depth_target_release(u, r);
+            else if (b->pipeline_release) b->pipeline_release(u, r);
+        }
+        break; }
+    case AR_CTC: { const ar_ctc* a = p;
+        ar_set(a->v, b->color_target_create(u, a->fmt, a->w, a->h, a->has_seed ? (const void*)(a + 1) : NULL,
+                                            a->seed_row_bytes)); break; }
+    case AR_CTW: { const ar_ctw* a = p;
+        b->color_target_write(u, ar_x(a->surface), a->x, a->y, a->w, a->h, a + 1, a->row_bytes); break; }
+    case AR_VIEW: { const ar_view* a = p; const u32 s = ar_x(a->surface);
+        ar_set(a->v, s ? b->surface_view(u, s, a->remap, a->fmt) : 0); break; }
+    case AR_DTC: { const ar_dtc* a = p; ar_set(a->v, b->depth_target_create(u, a->w, a->h)); break; }
+    case AR_DSNAP: { const ar_dsnap* a = p; const u32 d = ar_x(a->depth);
+        ar_set(a->v, d ? b->depth_snapshot(u, d, a->w, a->h) : 0); break; }
+    case AR_PIPE: { const ar_pipe* a = p; const char* vs = (const char*)(a + 1); const char* ps = vs + a->vs_len + 1;
+        ar_set(a->v, b->pipeline_create(u, vs, ps, a->has_rs ? &a->rs : NULL, a->has_layout ? &a->layout : NULL,
+                                        a->stride, a->rt_fmt, a->rt_count)); break; }
+    case AR_BT: { const ar_bt* a = p; u32 s[RSX_BE_MAX_COLOR_TARGETS];
+        for (u32 i = 0; i < a->count && i < RSX_BE_MAX_COLOR_TARGETS; i++) s[i] = ar_x(a->s[i]);
+        b->bind_targets(u, s, a->count, ar_x(a->depth)); break; }
+    case AR_BP: { const u32* a = p; b->bind_pipeline(u, ar_x(*a)); break; }
+    case AR_VSC: { const u32* a = p; b->bind_vs_constants(u, a + 4, a[0]); break; }
+    case AR_PSC: { const u32* a = p; b->bind_ps_constants(u, a + 4, a[0]); break; }
+    case AR_BTEX: case AR_BVTEX: { const ar_btex* a = p; u32 t[RSX_BE_MAX_TEXTURES];
+        for (u32 i = 0; i < RSX_BE_MAX_TEXTURES; i++) t[i] = ar_x(a->tex[i]);
+        { static int dl = -1, dn = 0;   /* VK_DUMMY_LOG: a bound virtual id whose object is gone */
+          if (dl < 0) dl = getenv("VK_DUMMY_LOG") ? 1 : 0;
+          if (dl && dn < 100)
+              for (u32 i = 0; i < RSX_BE_MAX_TEXTURES; i++) {
+                  const u32 vv = a->tex[i];
+                  if (!((a->mask >> i) & 1u) || !(vv & VK_AR_VBIT)) continue;
+                  const u32 id = vv & ~VK_AR_VBIT;
+                  if (t[i] && t[i] < VK_ENG_MAX_OBJ && s_eobj[t[i]].kind != VK_ENG_FREE) continue;
+                  dn++;
+                  VK_LOG("ar dummy: unit %u virtual 0x%x (%s) real 0x%x set by op %u\n", i, vv,
+                         id >= VK_AR_IDS ? "transient" : "persistent", t[i],
+                         id < VK_AR_IDS + VK_AR_TRANS ? s_ar_vop[id] : 0);
+              } }
+        if (hd->op == AR_BTEX) b->bind_textures(u, t, a->has_samp ? a->samp : NULL, a->mask);
+        else b->bind_vertex_textures(u, t, a->has_samp ? a->samp : NULL, a->mask);
+        break; }
+    case AR_VP: { const ar_f4* a = p; b->set_viewport(u, a->a, a->b, a->c, a->d); break; }
+    case AR_SC: { const ar_u4* a = p; b->set_scissor(u, a->a, a->b, a->c, a->d); break; }
+    case AR_STEN: { const u32* a = p; b->set_stencil_ref(u, *a); break; }
+    case AR_DB: { const ar_f4* a = p; b->set_depth_bounds(u, a->a, a->b); break; }
+    case AR_DRAW: { const ar_draw* a = p; const u8* v = (const u8*)(a + 1);
+        const size_t vb = ((size_t)a->vcount * a->stride + 15u) & ~(size_t)15u;
+        b->draw(u, a->topo, v, a->vcount, a->stride, a->icount ? (const u32*)(v + vb) : NULL, a->icount); break; }
+    case AR_CLRC: { const ar_clrc* a = p; b->clear_color(u, ar_x(a->surface), a->rgba); break; }
+    case AR_CLRD: { const ar_clrd* a = p; b->clear_depth_stencil(u, ar_x(a->depth), a->flags, a->dv, (u8)a->stencil); break; }
+    case AR_TEX3C: { const ar_tex3c* a = p;
+        ar_set(a->v, b->texture_create_3d(u, a->fmt, a->w, a->h, a->depth, a->mips, a->remap, a->rsx_fmt)); break; }
+    case AR_TEX3U: { const ar_tex3u* a = p;
+        b->texture_upload_3d(u, ar_x(a->tex), a->z, a->mip, a->w, a->h, a + 1, a->row_bytes); break; }
+    case AR_CLRCR: { const ar_clrcr* a = p;
+        b->clear_color_rect(u, ar_x(a->surface), a->rgba, a->x, a->y, a->w, a->h); break; }
+    case AR_CLRDR: { const ar_clrdr* a = p;
+        b->clear_depth_stencil_rect(u, ar_x(a->depth), a->flags, a->dv, (u8)a->stencil, a->x, a->y, a->w, a->h); break; }
+    case AR_DBIAS: { const ar_f4* a = p; b->set_depth_bias(u, a->a, a->b, (u32)a->c); break; }
+    case AR_PRESENT: { const u32* a = p; b->present(u, ar_x(*a)); break; }
+    case AR_CSNAP: { const ar_csnap* a = p; const u32 s = ar_x(a->surface);
+        ar_set(a->v, s ? b->color_snapshot(u, s) : 0); break; }
+    case AR_CSNAPR: { const ar_csnap* a = p; const u32 s = ar_x(a->surface);
+        ar_set(a->v, s ? b->color_snapshot_rect(u, s, a->w, a->h) : 0); break; }
+    case AR_RBA: { const ar_rba* a = p; const u32 s = ar_x(a->surface);
+        ar_set(a->v, s ? b->readback_async(u, s, a->x, a->y, a->w, a->h) : 0); break; }
+    case AR_SAW: { const u32* a = p; b->submit_and_wait(u, *a); break; }
+    case AR_DFETCH: { const u32* a = p;   /* topo, count, push_bytes, ib_off, ib_type, pad[3], push */
+        b->draw_fetch(u, (rsx_topology)a[0], a[1], a + 8, a[2], a[3], a[4]); break; }
+    case AR_FSER: { const unsigned long long* a = p; unsigned long long done = 0;
+        const unsigned long long S = b->fetch_serial(u, &done);
+        atomic_store_explicit(&s_ar_fsr[*a % AR_FSR_N], S, memory_order_relaxed);
+        atomic_store_explicit(&s_ar_real_done, done, memory_order_relaxed);
+        atomic_store_explicit(&s_ar_fs_exec, *a, memory_order_release);
+        break; }
+    default: break;
+    }
+}
+static void* vk_ar_thread(void* arg)
+{
+    (void)arg;
+    for (;;) {
+        size_t tail = atomic_load_explicit(&s_ar_tail, memory_order_relaxed);
+        if (tail == atomic_load_explicit(&s_ar_head, memory_order_acquire)) {
+            int spun = 0;   /* a short spin only: a long one burned a core (and its SMT sibling) */
+            while (spun < 64 && tail == atomic_load_explicit(&s_ar_head, memory_order_acquire)) { __builtin_ia32_pause(); spun++; }
+            if (tail == atomic_load_explicit(&s_ar_head, memory_order_acquire)) {
+                pthread_mutex_lock(&s_ar_qmu);
+                atomic_store(&s_ar_rec_sleeping, 1);
+                if (tail == atomic_load(&s_ar_head)) {
+                    struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_nsec += 2000000;
+                    if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+                    pthread_cond_timedwait(&s_ar_qcv, &s_ar_qmu, &ts);
+                }
+                atomic_store(&s_ar_rec_sleeping, 0);
+                pthread_mutex_unlock(&s_ar_qmu);
+            }
+            continue;
+        }
+        atomic_store_explicit(&s_ar_busy, 1, memory_order_release);
+        pthread_mutex_lock(&s_ar_mu);
+        struct timespec t0, t1; clock_gettime(CLOCK_MONOTONIC, &t0);
+        {
+            const size_t head = atomic_load_explicit(&s_ar_head, memory_order_acquire);
+            tail = atomic_load_explicit(&s_ar_tail, memory_order_relaxed);
+            /* everything published so far, tail stored once (every 512 commands at most) */
+            for (int n = 0; tail != head && n < 4096; n++) {   /* let direct callers in between */
+                const ar_hdr* h = (const ar_hdr*)(s_ar_ring + tail % VK_AR_RING);
