+    def test_inline_mfc_params_latch_like_spu_wrch(self):
+        cc = shutil.which('clang') or shutil.which('cc')
+        if not cc:
+            self.skipTest('C compiler unavailable')
+        prog = ([ri16(IL, 0x1234, 3), rr(WRCH, 0, 16, 3),     # wrch MFC_LSA, $3
+                 ri16(IL, 0x5670, 4), rr(WRCH, 0, 18, 4),     # wrch MFC_EAL, $4
+                 ri16(IL, 0x7F, 5), rr(WRCH, 0, 20, 5),       # wrch MFC_TagID, $5 (masked to 0x1F)
+                 rr(BI, 0, 0, 0)], [(0x00, 0x1C)])
+        driver = r'''
+#include "lifted.h"
+#include <stdio.h>
+SPU_THREAD_LOCAL void (*g_spu_trampoline_fn)(spu_context*);
+volatile int g_spu_direct = 0; uint8_t g_spu_stack_reset_hint[1024]; int g_spu_ls_watch_n = 0;
+void spu_ls_watch_slow(uint32_t a, int w, const uint8_t* p, uint32_t pc, uint32_t lr) { (void)a; (void)w; (void)p; (void)pc; (void)lr; }
+void spu_indirect_branch(spu_context* c) { (void)c; }
+void spu_register_function(uint32_t a, void (*f)(spu_context*)) { (void)a; (void)f; }
+static int calls;
+void spu_wrch(spu_context* c, uint32_t ch, u128 v) {          /* mfc_channel_write's latch */
+    calls++; uint32_t x = v._u32[0];
+    if (ch == 16) c->mfc_lsa = x; else if (ch == 18) c->mfc_eal = x; else if (ch == 20) c->mfc_tag = x & 0x1F;
+}
+int main(void) { static spu_context c; spu_func_00000000(&c);
+    printf("%x %x %x %d\n", c.mfc_lsa, c.mfc_eal, c.mfc_tag, calls); return 0; }
+'''
+        outs = []
+        for inline in (False, True):
+            words, bounds = prog
+            insns = disassemble_spu(b''.join(struct.pack('>I', w) for w in words), 0)
+            lifter = SPULifter(); lifter.func_starts = {0}; lifter.inline_mfc_params = inline
+            lifter.lift_function(insns, 0, 0x1C)
+            with tempfile.TemporaryDirectory() as tmp:
+                root = Path(tmp)
+                (root / 'lifted.h').write_text(lifter.emit_header().replace(
+                    '../../runtime/spu/spu_context.h', (RUNTIME / 'spu_context.h').as_posix()))
+                src = lifter.emit_source('lifted.h').replace('../../runtime/spu/spu_helpers.h',
+                                                             (RUNTIME / 'spu_helpers.h').as_posix())
+                (root / 'lifted.c').write_text(src); (root / 'driver.c').write_text(driver)
+                exe = root / 'proof'
+                b = subprocess.run([cc, '-O2', '-std=gnu11', '-I', str(RUNTIME), '-o', str(exe),
+                                    str(root / 'lifted.c'), str(root / 'driver.c')], capture_output=True, text=True)
+                self.assertEqual(b.returncode, 0, b.stderr)
+                outs.append(subprocess.run([str(exe)], capture_output=True, text=True).stdout.split())
+        self.assertEqual(outs[0], ['1234', '5670', '1f', '3'])     # via spu_wrch
+        self.assertEqual(outs[1], ['1234', '5670', '1f', '0'])     # inlined: same latch, no calls
+
