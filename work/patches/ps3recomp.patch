+     * accumulate would hash two swapped 128-byte blocks alike). */
+    const __m256i step = _mm256_set1_epi64x(0x9E3779B97F4A7C15ll);
+    __m256i ka = k0, kb = k1;
+    for (; i + 128 <= n; i += 128) {
+        EVH_ACC(a0, 0, ka); EVH_ACC(a1, 32, kb); EVH_ACC(a2, 64, ka); EVH_ACC(a3, 96, kb);
+        ka = _mm256_add_epi64(ka, step); kb = _mm256_sub_epi64(kb, step);
+    }
