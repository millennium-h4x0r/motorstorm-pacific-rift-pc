+/*
+ * ps3recomp - a user interface over the game's window (Dear ImGui, Vulkan)
+ *
+ * The port's in-game menu (F1) and FPS counter are drawn with this. Only a
+ * windowed run (PS3RECOMP_VK_WINDOW=1) has a UI; offscreen runs never start it. The
+ * frame is built on the thread that owns the SDL window (the rsx thread:
+ * events and SDL calls stay there), copied, and recorded into the swapchain
+ * image by whichever thread presents the window, after the game frame's blit.
+ * What is drawn is the port's: it registers a callback (rsx_ui_set_draw) and
+ * makes ImGui calls in it.
+ */
+#ifndef PS3RECOMP_RSX_UI_H
+#define PS3RECOMP_RSX_UI_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The port's widgets, called once per UI frame between ImGui::NewFrame and
+ * ImGui::Render. */
+void rsx_ui_set_draw(void (*draw)(void* user), void* user);
+
+/* The port's function keys: F2-F10 and F12 key presses (SDL keycodes) go to
+ * `fn` on the window's thread while no modal screen is up; it returns 1 when
+ * it used the key. */
+void rsx_ui_set_hotkey(int (*fn)(int key, void* user), void* user);
+
+/* Rsx thread: an SDL event (const SDL_Event*). Returns 1 when the UI took it
+ * and the game should not see it. */
+int  rsx_ui_event(const void* sdl_event);
+
+/* Rsx thread: build one UI frame and keep a copy for the next window
+ * present. Cheap when nothing is shown. */
+void rsx_ui_frame(void);
+
+/* Whether the menu is open (the game gets a neutral pad), and opening or
+ * closing it. */
+int  rsx_ui_menu_open(void);
+void rsx_ui_set_menu_open(int open);
+
+/* Whether anything is drawn at all (the menu, the start screen, the FPS
+ * counter): the present skips the UI pass when not. */
+void rsx_ui_set_visible(int visible);
+
+/* A screen that owns the window (the start screen): every event goes to the
+ * UI, F1 and Select+Start do nothing, Escape does not quit. */
+void rsx_ui_set_modal(int on);
+
+/* The monitor the window is on (SDL's index). */
+int  rsx_ui_display_index(void);
+
+/* Seconds since the previous rsx_ui_frame, for the port's FPS counter and
+ * hold-to-open timing. */
+double rsx_ui_frame_dt(void);
+
+/* Whether the UI is up: started, and not failed or torn down since. A start
+ * screen gives up waiting when it is not. */
+int  rsx_ui_available(void);
+
+/* The window's thread, every event pump: finish a teardown another thread
+ * started (the SDL side and the ImGui context live on this one). */
+void rsx_ui_reap(void);
+
+/* A picture for the port's screens, RGBA8, copied: uploaded by the next
+ * present. One per run. */
+void rsx_ui_set_image(const void* rgba, int w, int h);
+
+/* The picture as an ImTextureID once it is on the GPU, else NULL. From the
+ * draw callback only. */
+void* rsx_ui_image(int* w, int* h);
+
+/* The large font for titles (ImFont*), or NULL: the regular one then. */
+void* rsx_ui_title_font(void);
+
+/* The window full screen (desktop resolution) or not, and its state now
+ * (F11 / Alt+Enter change it behind the menu's back). From the draw callback
+ * or the window's thread. */
+void rsx_ui_set_fullscreen(int on);
+int  rsx_ui_fullscreen(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
