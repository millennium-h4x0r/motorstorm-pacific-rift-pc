+#if (defined(__x86_64__) || defined(_M_X64)) && (defined(__GNUC__) || defined(__clang__))
+#include <immintrin.h>
+/* Bulk hash of large vertex ranges with AVX2: XXH3-style accumulate, four
+ * 256-bit accumulators over 128 bytes per step (acc += swap64(d) +
+ * lo32(d^k) * hi32(d^k)). The vertex-cache key hashes ~35 MB of source
+ * ranges per pack-racing frame; the scalar 4-lane loop ran at ~9 GB/s
+ * (4 ms/frame), this one is memory-bound. Only consistency within a run
+ * matters (cache keys), so the result need not match the scalar path. */
+__attribute__((target("avx2")))
+static size_t eng_vhash_bulk_avx2(u64* pa, u64* pb, const u8* p, size_t n)
+{
+    const __m256i k0 = _mm256_set_epi64x(0x1cad21f72c81017cll, 0xdb979083e96dd4dell,
+                                         0x7c01812cf721ad1cll, 0xbe4ba423396cfeb8ll);
+    const __m256i k1 = _mm256_set_epi64x(0x3f349ce33f76faa8ll, 0x1d4f0bc7c7bbdcf9ll,
+                                         0x3159b4cd4be0518all, 0x647378d9c97e9fc8ll);
+    __m256i a0 = _mm256_set1_epi64x((long long)*pa), a1 = _mm256_set1_epi64x((long long)*pb);
+    __m256i a2 = _mm256_set1_epi64x((long long)(*pa ^ 0x9E3779B97F4A7C15ull));
+    __m256i a3 = _mm256_set1_epi64x((long long)(*pb ^ 0xC2B2AE3D27D4EB4Full));
+    size_t i = 0;
+#define EVH_ACC(acc, off, key) do { \
+        const __m256i d = _mm256_loadu_si256((const __m256i*)(p + i + (off))); \
+        const __m256i dk = _mm256_xor_si256(d, key); \
+        const __m256i pr = _mm256_mul_epu32(dk, _mm256_srli_epi64(dk, 32)); \
+        acc = _mm256_add_epi64(acc, _mm256_add_epi64(_mm256_shuffle_epi32(d, 0x4E), pr)); \
+    } while (0)
+    /* The keys advance every step so the sum is position dependent (a plain
+     * accumulate would hash two swapped 128-byte blocks alike). */
+    const __m256i step = _mm256_set1_epi64x(0x9E3779B97F4A7C15ll);
+    __m256i ka = k0, kb = k1;
+    for (; i + 128 <= n; i += 128) {
+        EVH_ACC(a0, 0, ka); EVH_ACC(a1, 32, kb); EVH_ACC(a2, 64, ka); EVH_ACC(a3, 96, kb);
+        ka = _mm256_add_epi64(ka, step); kb = _mm256_sub_epi64(kb, step);
+    }
+#undef EVH_ACC
+    u64 l[16];
+    _mm256_storeu_si256((__m256i*)&l[0], a0); _mm256_storeu_si256((__m256i*)&l[4], a1);
+    _mm256_storeu_si256((__m256i*)&l[8], a2); _mm256_storeu_si256((__m256i*)&l[12], a3);
+    u64 a = *pa, b = *pb;
+    for (int j = 0; j < 16; j++) {
+        a = (a ^ l[j]) * 0x9E3779B97F4A7C15ull; a ^= a >> 29;
+        b = (b + l[j] * 0xC2B2AE3D27D4EB4Full); b = ((b << 31) | (b >> 33)) * 0x165667B19E3779F9ull;
+    }
+    *pa = a ^ (u64)i; *pb = b;
+    return i;
+}
+static int eng_have_avx2(void)
+{
+    static int v = -1;
+    if (v < 0) v = __builtin_cpu_supports("avx2") ? 1 : 0;
+    return v;
+}
+#define ENG_VHASH_AVX2 1
+#endif
+
+static inline void eng_vhash_words(eng_vhash* h, const void* data, size_t n)
+{
+    const u8* p = (const u8*)data;
+    u64 a = h->h1, b = h->h2;
+    size_t i = 0;
+#ifdef ENG_VHASH_AVX2
+    if (n >= 512 && eng_have_avx2())
+        i = eng_vhash_bulk_avx2(&a, &b, p, n);
+#endif
+    /* Bulk: four independent lanes of 8 bytes, so the multiplies overlap
+     * instead of forming one dependency chain (about 3x the throughput of
+     * the single-lane loop on the vertex pools). */
+    if (n >= 64) {
+        u64 l0 = a, l1 = b, l2 = a ^ 0x9E3779B97F4A7C15ull, l3 = b ^ 0xC2B2AE3D27D4EB4Full;
+        for (; i + 32 <= n; i += 32) {
+            u64 w0, w1, w2, w3;
+            memcpy(&w0, p + i, 8); memcpy(&w1, p + i + 8, 8);
+            memcpy(&w2, p + i + 16, 8); memcpy(&w3, p + i + 24, 8);
+            l0 = ((l0 ^ w0) * 0x9E3779B97F4A7C15ull); l0 ^= l0 >> 29;
+            l1 = ((l1 ^ w1) * 0xC2B2AE3D27D4EB4Full); l1 ^= l1 >> 31;
+            l2 = ((l2 ^ w2) * 0x165667B19E3779F9ull); l2 ^= l2 >> 27;
+            l3 = ((l3 ^ w3) * 0xD6E8FEB86659FD93ull); l3 ^= l3 >> 33;
+        }
+        a = (a ^ l0 ^ (l1 << 1)) * 0x100000001b3ull;
+        b = (b + l2 + (l3 << 3)) * 0x9E3779B97F4A7C15ull;
+        a ^= l2 * 0xC2B2AE3D27D4EB4Full;
+        b ^= l0 * 0x165667B19E3779F9ull ^ l1 ^ l3;
+    }
+    for (; i + 8 <= n; i += 8) {
+        u64 w; memcpy(&w, p + i, 8);
+        a = (a ^ w) * 0x100000001b3ull;
+        b = (b + w * 0x9E3779B97F4A7C15ull);
+        b = ((b << 31) | (b >> 33)) * 0xC2B2AE3D27D4EB4Full;
+    }
+    u64 tail = 0;
+    if (i < n) memcpy(&tail, p + i, n - i);
+    a = (a ^ tail ^ (u64)n) * 0x100000001b3ull;
+    b = ((b + tail + n) * 0x9E3779B97F4A7C15ull);
+    h->h1 = a; h->h2 = b;
+}
+
+/* The guest bytes of one source range, hashed at most once a frame. A race
+ * frame's draws reference a few large shared vertex pools, each draw a slice
+ * of one, and hashing every slice again was 26-42 MB a frame. Within a frame
+ * a range is taken as unchanged unless an SPU wrote its IO pages since
+ * (rsx_draw_engine_io_written); a CPU rewrite of the same range between two
+ * draws of one frame would go unseen until the next frame, the window the
+ * engine already accepts for textures (ENG_TEXHASH_FULL_EVERY). */
+#define ENG_RMEMO_SLOTS 8192u
+typedef struct { const u8* p; u64 n; u32 frame, io_gen; eng_vhash h; } eng_rmemo;
+static eng_rmemo s_rmemo[ENG_RMEMO_SLOTS];
+
+static eng_vhash eng_range_hash(const u8* p, u64 n, u32 location, u32 offset)
+{
+    const u64 k = ((u64)(uintptr_t)p * 0x9E3779B97F4A7C15ull) ^ (n * 0xC2B2AE3D27D4EB4Full);
+    eng_rmemo* m = &s_rmemo[(k >> 40) & (ENG_RMEMO_SLOTS - 1u)];
+    const u32 io_gen = location == RSX_LOCATION_MAIN && n <= 0xFFFFFFFFull
+        ? eng_io_written_gen(offset, (u32)n) : 0u;
+    if (m->p == p && m->n == n && m->frame == g.frames && m->io_gen >= io_gen)
+        return m->h;
+    eng_vhash h = { 0x9ae16a3b2f90404full, 0xc3a5c85c97cb3127ull };
+    m->io_gen = __atomic_load_n(&s_io_gen, __ATOMIC_RELAXED);
+    eng_vhash_words(&h, p, (size_t)n);
+    if (EP_ON()) s_vc_hashed += n;
+    m->p = p; m->n = n; m->frame = g.frames; m->h = h;
+    return h;
+}
+
+static int eng_vcache_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_VCACHE"); on = !(e && *e == '0'); }
+    return on;
+}
