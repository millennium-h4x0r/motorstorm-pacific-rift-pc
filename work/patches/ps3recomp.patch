@@ -409,6 +409,26 @@ static int s_gcm_syscall_mode = 0;
  * Internal helpers
  * -----------------------------------------------------------------------*/
 
+/* Set once cellGcmGetOffsetTable has handed the guest its copy of the tables
+ * (GCM_OFFSET_TABLE_IO_ADDR / _EA_ADDR). From then on every map and unmap
+ * must update that copy too: libgcm's table is the live one, and a title is
+ * entitled to keep the pointers and index them for every later mapping.
+ * MotorStorm: Pacific Rift fetches the table at boot, maps its SPU
+ * command-list buffers (cellGcmMapMainMemory 0x17100000/0x17500000) after
+ * that, and converts each list's EA through ioAddress[ea >> 20] itself. The
+ * stale copy said 0xFFFF (unmapped) there, so every CALL into an SPU-built
+ * list went out as 0xFFFFFFFF -- an invalid word the walker skips -- and the
+ * terrain, vehicles and most of the race scene were never drawn. */
+static int s_offset_tables_published = 0;
+static void gcm_offset_table_entry_publish(u32 ea_page, u32 io_page)
+{
