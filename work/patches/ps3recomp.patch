+static const char kEngFetchPreamble[] =
+"struct RsxFetchPC { uint4 d; uint4 a[8]; float4 ps; float4 po; };\n"
+"[[vk::push_constant]] ConstantBuffer<RsxFetchPC> rsx_f;\n"
+"[[vk::binding(0, 1)]] ByteAddressBuffer rsx_pool;\n"
+"uint rsx_u32le(uint a) { uint b = a & ~3u; uint s = (a & 3u) * 8u; uint w0 = rsx_pool.Load(b);\n"
+"    if (s == 0u) return w0; uint w1 = rsx_pool.Load(b + 4u); return (w0 >> s) | (w1 << (32u - s)); }\n"
+"uint rsx_bswap(uint x) { return (x >> 24) | ((x >> 8) & 0xFF00u) | ((x << 8) & 0xFF0000u) | (x << 24); }\n"
+"uint rsx_be32(uint a) { return rsx_bswap(rsx_u32le(a)); }\n"
+"uint rsx_be16(uint a) { uint v = rsx_u32le(a); return ((v & 0xFFu) << 8) | ((v >> 8) & 0xFFu); }\n"
+"uint rsx_u8(uint a) { return (rsx_pool.Load(a & ~3u) >> ((a & 3u) * 8u)) & 0xFFu; }\n"
+"int rsx_s16(uint v) { return ((int)(v << 16)) >> 16; }\n"
