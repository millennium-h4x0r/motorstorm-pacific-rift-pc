+ *   cc -std=gnu17 -O1 -DPS3RECOMP_HAS_FREETYPE -Iinclude -Ilibs/font \
+ *      $(pkg-config --cflags freetype2) libs/font/tests/test_cellfont.c \
+ *      $(pkg-config --libs freetype2) -lm -o /tmp/test_cellfont
