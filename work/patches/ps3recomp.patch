+                if ((n & 511) == 511) atomic_store_explicit(&s_ar_tail, tail, memory_order_release);
+            }
+            atomic_store_explicit(&s_ar_tail, tail, memory_order_release);
+        }
+        clock_gettime(CLOCK_MONOTONIC, &t1);
+        s_ar_rec_ns += (unsigned long long)((t1.tv_sec - t0.tv_sec) * 1000000000ll + (t1.tv_nsec - t0.tv_nsec));
