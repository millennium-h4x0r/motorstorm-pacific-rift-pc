+static u32 eng_surface_reinterpret(eng_surface* s, const rsx_dsp_texture* t, u32 base_fmt)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_REINTERPRET"); on = !(e && *e == '0'); }
