+++ b/libs/video/rsx_ui_vk.h
@@ -0,0 +1,53 @@
+/*
+ * ps3recomp - rsx_ui.cpp's side of the Vulkan backend (rsx_vulkan_backend.c).
+ */
+#ifndef PS3RECOMP_RSX_UI_VK_H
+#define PS3RECOMP_RSX_UI_VK_H
+
+#include <stdint.h>
+#include <vulkan/vulkan.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct rsx_ui_vk_info {
+    PFN_vkGetInstanceProcAddr gipa;
+    VkInstance       instance;
+    VkPhysicalDevice phys;
+    VkDevice         device;
+    uint32_t         queue_family;
+    VkQueue          queue;
+} rsx_ui_vk_info;
+
+/* Once the device exists and the window is open. Nothing is created yet: the
+ * pipeline needs the swapchain's format (rsx_ui_vk_swapchain). 0 when the UI
+ * can run, -1 when it is off (PS3RECOMP_UI=0) or cannot. */
+int  rsx_ui_vk_init(void* sdl_window, const rsx_ui_vk_info* info);
+
+/* After the swapchain is created or created again, with the device idle and
+ * on the thread that submits to the queue: the image views, the render pass,
+ * the framebuffers, and on the first call ImGui's pipeline and font texture.
+ * The images must allow VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT. */
+void rsx_ui_vk_swapchain(VkFormat format, uint32_t count, const VkImage* images,
+                         uint32_t width, uint32_t height);
+
+/* After the game frame's blit into swapchain image `image`, which is in
+ * TRANSFER_DST_OPTIMAL: the UI pass over it. Returns 1 when it recorded one,
+ * which leaves the image in PRESENT_SRC_KHR; 0 when there is nothing to draw,
+ * and the caller makes the transition itself. */
+int  rsx_ui_vk_record(VkCommandBuffer cb, uint32_t image);
+
+/* The usage bits the UI needs on the swapchain images, out of what the
+ * surface supports: COLOR_ATTACHMENT for its pass, and TRANSFER_SRC while a
+ * screenshot is asked for (PS3RECOMP_UI_SHOT). 0 when the UI cannot draw. */
+VkImageUsageFlags rsx_ui_vk_image_usage(VkImageUsageFlags supported);
+
+/* Before the device goes, with nothing in flight. */
+void rsx_ui_vk_shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
