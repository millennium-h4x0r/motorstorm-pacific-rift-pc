+/* The guest bytes of one source range, hashed at most once a frame. A race
+ * frame's draws reference a few large shared vertex pools, each draw a slice
+ * of one, and hashing every slice again was 26-42 MB a frame. Within a frame
+ * a range is taken as unchanged unless an SPU wrote its IO pages since
+ * (rsx_draw_engine_io_written); a CPU rewrite of the same range between two
+ * draws of one frame would go unseen until the next frame, the window the
+ * engine already accepts for textures (ENG_TEXHASH_FULL_EVERY). */
+#define ENG_RMEMO_SLOTS 8192u
+typedef struct { const u8* p; u64 n; u32 frame, io_gen; eng_vhash h; } eng_rmemo;
+static eng_rmemo s_rmemo[ENG_RMEMO_SLOTS];
+
+static eng_vhash eng_range_hash(const u8* p, u64 n, u32 location, u32 offset)
+{
+    const u64 k = ((u64)(uintptr_t)p * 0x9E3779B97F4A7C15ull) ^ (n * 0xC2B2AE3D27D4EB4Full);
