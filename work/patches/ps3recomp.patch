+                                     &layout, layout.stride, RSX_BE_FMT_R16G16B16A16F, 1);
+        if (!pipe) {
+            pipe_failed = 1;
+            fprintf(stderr, "[rsx engine] reinterpret pipeline failed; RGBA8 read as Y16_X16_FLOAT"
+                            " goes through guest memory\n");
+            return 0;
+        }
+    }
+    if (!pipe) return 0;
+
+    if (!s->rei || s->rei_w != t->width || s->rei_h != t->height) {
+        if (s->rei) g.be->color_target_release(g.be->user, s->rei);
+        s->rei = g.be->color_target_create(g.be->user, RSX_BE_FMT_R16G16B16A16F,
+                                           t->width, t->height, NULL, 0);
+        s->rei_w = t->width; s->rei_h = t->height;
+        if (!s->rei) return 0;
+    }
