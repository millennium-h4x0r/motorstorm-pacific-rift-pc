+    def test_const_bi_goto_and_ls_round_trip(self):
+        base, _ = self.run_program(lift(CONSTBI), 0)
+        lr, src = self.run_program(lift(CONSTBI, local_regs=True, const_bi=True), 0)
+        # Without --const-bi, `bi $4` leaves through spu_indirect_branch (the
+        # driver's stub ends the run there); with it, a goto reaches 0x18 (the
+        # one indirect left is the final `bi $0` at host depth 0).
+        self.assertEqual(base[2], '0')
+        self.assertEqual(base[5], '1')
+        self.assertEqual(lr[2], '6')                    # r5 = LS[0x100] + 1
+        self.assertEqual(lr[1], '5')                    # r3 written back at the exit
+        self.assertIn('goto loc_00000018;', src)
+        self.assertIn('spu_irq_pending(ctx)', src)
+
+    def test_runtime_call_sees_and_returns_registers(self):
+        base, _ = self.run_program(lift(SYNC), 0)
+        lr, src = self.run_program(lift(SYNC, local_regs=True), 0)
+        self.assertEqual(base[3:5], ['56', '13'])       # r8 = 42 + 1 + 13; wrch saw r6 = 13
+        self.assertEqual(lr, base)
+        self.assertIn('ctx->gpr[6] = spu_v2u(sr6);', src)
