+/* A depth target's snapshot keeps one persistent virtual id, as the backend
+ * keeps one handle per depth target and refills it: the engine releases its
+ * previous snapshot only when the handle it gets back differs, so a new
+ * virtual id per call made it release the real snapshot the new id also
+ * names (bound later: freed, sampled as the magenta dummy). */
+static u32 s_ar_dsnap[VK_AR_IDS];         /* depth id -> its snapshot's virtual id */
+static u32 s_ar_dsnap_of[VK_AR_IDS];      /* snapshot id -> its depth's virtual id */
+static void ar_release(u32 kind, u32 h)
+{
+    if (!h || !ar_vlive(h)) return;          /* already released: the engine releases some twice */
+    if (h & VK_AR_VBIT) {
+        const u32 id = h & ~VK_AR_VBIT;
+        if (id < VK_AR_IDS && kind == AR_REL_TEX && s_ar_dsnap_of[id]) {
+            const u32 d = s_ar_dsnap_of[id] & ~VK_AR_VBIT;
+            if (d < VK_AR_IDS && s_ar_dsnap[d] == h) s_ar_dsnap[d] = 0;
+            s_ar_dsnap_of[id] = 0;
+        }
+        if (id < VK_AR_IDS && kind == AR_REL_DT && s_ar_dsnap[id]) {
+            /* the backend frees the snapshot with its depth target */
+            const u32 sv = s_ar_dsnap[id];
+            s_ar_dsnap[id] = 0;
+            if ((sv & ~VK_AR_VBIT) < VK_AR_IDS) s_ar_dsnap_of[sv & ~VK_AR_VBIT] = 0;
+            ar_vfree(sv);
+        }
+    }
+    AR_PUT(AR_REL, ar_rel, a); a->kind = kind; a->h = h; ar_commit();
+    memset(&s_ar_st, 0, sizeof s_ar_st);
+    if (kind == AR_REL_CT || kind == AR_REL_TEX) ar_drop_views_of(h);   /* a snapshot (COLOR) goes via texture_release */
+    ar_vfree(h);
+}
