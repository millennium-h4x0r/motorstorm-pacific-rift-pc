+            const unsigned long long now = (unsigned long long)t1.tv_sec * 1000000000ull + (unsigned long long)t1.tv_nsec;
+            if (st && now - t_last > 2000000000ull) {
+                if (t_last) fprintf(stderr, "[vk-ar] %.1f s: %llu commands, %llu drains, recording %.1f ms\n",
+                                    (now - t_last) / 1e9, s_ar_cmds, s_ar_drains, s_ar_rec_ns / 1e6);
