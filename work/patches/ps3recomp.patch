+/* Attribute k: w0 its element-0 address, w1 stride | type << 8 | size << 11
+ * | divider mode << 14 (0 plain, 1 modulo, 2 divide) | frequency << 16. A
+ * disabled attribute is a stride-0 float4 holding its constant. */
+"float4 rsx_attr(uint k, uint vtx) {\n"
+"    uint4 e = rsx_f.a[k >> 1];\n"
+"    uint w0 = (k & 1u) ? e.z : e.x, w1 = (k & 1u) ? e.w : e.y;\n"
+"    uint mode = (w1 >> 14) & 3u;\n"
+"    uint freq = w1 >> 16;\n"
+"    uint el = mode == 0u ? ((vtx + rsx_f.d.w) & 0xFFFFFu) : (mode == 1u ? vtx % freq : vtx / freq);\n"
+"    uint a = w0 + el * (w1 & 0xFFu);\n"
+"    uint type = (w1 >> 8) & 7u, size = (w1 >> 11) & 7u;\n"
+"    if (type == 6u) { uint w = rsx_be32(a);\n"
+"        return float4((float)(((int)(w << 21)) >> 21) / 1023.0, (float)(((int)(w << 10)) >> 21) / 1023.0,\n"
+"                      (float)(((int)w) >> 22) / 511.0, 1.0); }\n"
+"    float4 v = float4(0, 0, 0, 1);\n"
+"    [unroll] for (uint i = 0u; i < 4u; i++) {\n"
+"        if (i < size) {\n"
+"            float f;\n"
+"            if (type == 2u) f = asfloat(rsx_be32(a + i * 4u));\n"
+"            else if (type == 3u) f = f16tof32(rsx_be16(a + i * 2u));\n"
+"            else if (type == 4u) f = (float)rsx_u8(a + i) / 255.0;\n"
+"            else if (type == 7u) f = (float)rsx_u8(a + i);\n"
+"            else if (type == 1u) f = (float)rsx_s16(rsx_be16(a + i * 2u)) / 32767.0;\n"
+"            else f = (float)rsx_s16(rsx_be16(a + i * 2u));\n"
+"            v[i] = f;\n"
+"        }\n"
+"    }\n"
+"    return v;\n"
+"}\n";
