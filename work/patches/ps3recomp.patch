diff --git a/libs/video/tests/test_fp_decompiler.c b/libs/video/tests/test_fp_decompiler.c
index 033d2528..370e7dae 100644
--- a/libs/video/tests/test_fp_decompiler.c
+++ b/libs/video/tests/test_fp_decompiler.c
@@ -591,6 +591,33 @@ int main(void)
 
     }
 
+    /* R[n] and H[2n]/H[2n+1] are one register: a program that packs two
+     * halves by writing h0.xy and reading r0.x (UP4UB) must see the halves'
+     * bits there, and an fp32 write read back through its halves must split. */
+    {
+        u8 prog[48];
+        const u32 mask_xy = (1u << 9) | (1u << 10);
+        put_word(prog + 0, OPC(0x01) | mask_xy | OUTHALF | INSRC(1));  /* MOV h0.xy, COL0 */
+        put_word(prog + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8, T_INPUT | SWZ_IDENT);
+        put_word(prog + 12, T_INPUT | SWZ_IDENT);
+        put_word(prog + 16, OPC(0x28) | OUTMASK_ALL | OUTREG(2));      /* UP4UB r2, r0.x */
+        put_word(prog + 20, T_TEMP | REG(0) | EXEC_ALWAYS);
+        put_word(prog + 24, T_INPUT | SWZ_IDENT);
+        put_word(prog + 28, T_INPUT | SWZ_IDENT);
+        put_word(prog + 32, OPC(0x01) | OUTMASK_ALL | OUTHALF | OUTREG(4) | END); /* MOV h4, h5 */
+        put_word(prog + 36, T_TEMP | REG(5) | (1u << 8) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 40, T_INPUT | SWZ_IDENT);
+        put_word(prog + 44, T_INPUT | SWZ_IDENT);
+        rsx_fp_decompile(prog, sizeof prog, CTRL_32BIT, hlsl, sizeof hlsl);
+        check("alias_h_to_r", hlsl,
+              "    r[0].x = asfloat(f32tof16(h[0].x) | (f32tof16(h[0].y) << 16));\n");
+        check("alias_r_to_h", hlsl,
+              "    h[5].zw = f16tof32(uint2(asuint(r[2].w) & 0xFFFFu, asuint(r[2].w) >> 16));\n");
+        check_absent("alias_unread_halves", hlsl, "h[4].xy = f16tof32");
+        check_absent("alias_unread_full", hlsl, "r[2].x = asfloat");
+    }
+
     printf("\n===========================================\n");
     printf("Results: %d passed, %d failed\n", g_pass, g_fail);
     return g_fail ? 1 : 0;
